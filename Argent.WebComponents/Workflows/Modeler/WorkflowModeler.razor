@using System.Security.Claims
@using System.Globalization
@using Argent.Core.Authorization
@using Argent.Core.Workflows
@using Argent.WebComponents.Workflows.Modeler
@using Argent.WebComponents.Workflows.Modeler.Editing
@using Argent.WebComponents.Workflows.Modeler.Interaction
@using Argent.WebComponents.Workflows.Modeler.Routing
@using Argent.Core.Workflows.Activities
@using Argent.Core.Workflows.BoundaryEvents
@using Argent.Core.Workflows.Intermediates
@using Microsoft.JSInterop
@using Argent.WebComponents.Workflows.Modeler.Utils
@inject IStringLocalizer<SharedResource> Localizer

<div class="modeler-layout"
     @onkeydown="OnKeyDown"
     @onkeyup="OnKeyUp">
    @if (EffectiveReadOnly)
    {
        <div class="modeler-toolbox modeler-toolbox-readonly">
            <div class="modeler-toolbox-header">
                <span class="modeler-toolbox-title">Viewing @State.LoadedVersionId.HasValue ? "version" : "draft"</span>
            </div>
            <div class="modeler-toolbox-list">
                <p class="modeler-toolbox-readonly-msg">
                    <i class="bi bi-eye-fill"></i> This workflow is read-only. Editing is disabled.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="modeler-toolbox">
            <div class="modeler-toolbox-header">
                <span class="modeler-toolbox-title">Components</span>
            </div>
            <div class="modeler-toolbox-list">
                @foreach (var desc in Registry.GetRegisteredTypes().OrderBy(d => d.Category).ThenBy(d => d.DisplayName))
                {
                    <div class="modeler-toolbox-item @desc.CssClass"
                         @onpointerdown="e => OnToolboxPointerDown(e, desc)">
                        <span class="modeler-toolbox-icon material-symbols-outlined">@desc.Icon</span>
                        <span class="modeler-toolbox-label">@desc.DisplayName</span>
                    </div>
                }
                <div class="modeler-toolbox-section-header">Structure</div>
                <div class="modeler-toolbox-item"
                     @onclick="HandleAddPool">
                    <span class="modeler-toolbox-icon material-symbols-outlined">view_column</span>
                    <span class="modeler-toolbox-label">Pool</span>
                </div>
            </div>
        </div>
    }
    <div class="modeler-resizer modeler-resizer-h"
         data-resize-prop="--toolbox-width"
         data-resize-axis="x"
         data-resize-min="120"></div>
    <div class="modeler-main">
        <div class="modeler-toolbar">
            <div class="modeler-toolbar-left">
                <div class="modeler-tool-group">
                    <button class="modeler-tool-btn @(_activeTool == ActiveTool.Select ? "modeler-tool-btn-active" : "")"
                            @onclick="() => SetTool(ActiveTool.Select)" title="Select and move (V)">
                        <i class="bi bi-hand-index-thumb"></i> Select
                    </button>
                    <button class="modeler-tool-btn @(_activeTool == ActiveTool.AddSpace ? "modeler-tool-btn-active" : "")"
                            @onclick="() => SetTool(ActiveTool.AddSpace)" title="Add or remove space (S)">
                        <i class="bi bi-arrows-expand"></i> Space
                    </button>
                </div>
                @if (!EffectiveReadOnly)
                {
                    <span class="modeler-toolbar-sep"></span>
                    <div class="modeler-tool-group">
                        <button class="modeler-btn-icon" title="Undo (Ctrl+Z)" aria-label="Undo"
                                disabled="@(!State.History.CanUndo)" @onclick="Undo">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                        <button class="modeler-btn-icon" title="Redo (Ctrl+Y)" aria-label="Redo"
                                disabled="@(!State.History.CanRedo)" @onclick="Redo">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="modeler-tool-wrap">
                        <button class="modeler-btn-icon" title="Align and distribute the selection"
                                aria-label="Align and distribute" @onclick="() => _showArrange = !_showArrange">
                            <i class="bi bi-distribute-vertical"></i>
                        </button>
                        @if (_showArrange)
                        {
                            <div class="modeler-menu">
                                <div class="modeler-menu-title">Align</div>
                                @foreach (var (mode, icon, label) in ArrangeOptions)
                                {
                                    <button class="modeler-menu-item" @onclick="() => ApplyAlign(mode)">
                                        <i class="bi @icon"></i> @label
                                    </button>
                                }
                                <div class="modeler-menu-title">Distribute</div>
                                <button class="modeler-menu-item" @onclick="() => ApplyDistribute(DistributeMode.Horizontal)">
                                    <i class="bi bi-distribute-horizontal"></i> Horizontally
                                </button>
                                <button class="modeler-menu-item" @onclick="() => ApplyDistribute(DistributeMode.Vertical)">
                                    <i class="bi bi-distribute-vertical"></i> Vertically
                                </button>
                            </div>
                        }
                    </div>
                }
                <span class="modeler-toolbar-sep"></span>
                <span class="modeler-toolbar-title">@State.CurrentWorkflowName</span>
                @if (!string.IsNullOrEmpty(State.CurrentWorkflowDescription))
                {
                    <span class="modeler-toolbar-sep">—</span>
                    <span class="modeler-toolbar-subtitle">@State.CurrentWorkflowDescription</span>
                }
            </div>
            <div class="modeler-toolbar-right">
                @if (!EffectiveReadOnly)
                {
                    <button class="modeler-btn-icon" title="Save (Ctrl+S)" aria-label="Save" @onclick="HandleSave">
                        <i class="bi bi-save-fill"></i>
                    </button>
                    <span class="modeler-save-status @SaveStatusClass" title="@SaveStatusTitle">
                        <i class="bi @SaveStatusIcon"></i>
                    </span>
                    <button class="modeler-btn-icon" title="Compile" aria-label="Compile" @onclick="HandleCompile">
                        <i class="bi bi-gear-fill"></i>
                    </button>
                    @if (State.CompiledDefinition != null)
                    {
                        <button class="modeler-btn-icon" title="Test Run" aria-label="Test Run" @onclick="HandleTestRun">
                            <i class="bi bi-play-fill"></i>
                        </button>
                    }
                    <span class="modeler-toolbar-sep"></span>
                }
                @if (State.SelectedConnection is { } routedConnection && !EffectiveReadOnly)
                {
                    <button class="modeler-btn-icon" aria-label="Reset routing"
                            title="Reset routing to automatic"
                            disabled="@(!ElasticRouter.HasIntent(routedConnection))"
                            @onclick="() => HandleResetRouting(routedConnection)">
                        <i class="bi bi-signpost-split"></i>
                    </button>
                }
                <button class="modeler-btn-icon" title="Zoom out" aria-label="Zoom out" @onclick="() => ZoomBy(1 / 1.2)">
                    <i class="bi bi-dash-lg"></i>
                </button>
                <span class="modeler-zoom-label">@(Math.Round(Session.Zoom * 100))%</span>
                <button class="modeler-btn-icon" title="Zoom in" aria-label="Zoom in" @onclick="() => ZoomBy(1.2)">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <button class="modeler-btn-icon" title="Fit to screen (Ctrl+0)" aria-label="Fit to screen" @onclick="FitToScreen">
                    <i class="bi bi-arrows-angle-contract"></i>
                </button>
                <button class="modeler-btn-icon" title="Focus the selection" aria-label="Focus the selection"
                        disabled="@(State.SelectedNodes.Count == 0)" @onclick="FocusSelection">
                    <i class="bi bi-crosshair"></i>
                </button>
                <button class="modeler-btn-icon" title="Keyboard shortcuts" aria-label="Keyboard shortcuts"
                        aria-expanded="@(_showShortcuts ? "true" : "false")"
                        @onclick="() => _showShortcuts = !_showShortcuts">
                    <i class="bi bi-keyboard"></i>
                </button>
            </div>
        </div>
        @if (State.SaveState == SaveState.Failed && !string.IsNullOrEmpty(State.LastSaveError))
        {
            <div class="modeler-save-error" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>Saving failed: @State.LastSaveError. Your changes are still here.</span>
                <button class="modeler-btn-icon" title="Retry saving" aria-label="Retry saving" @onclick="HandleSave">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        }
        <div class="modeler-body">
            <div class="modeler-canvas-col">
            <div @ref="_canvasContainer"
                 class="modeler-canvas @(_activeTool == ActiveTool.AddSpace ? "modeler-cursor-space" : "") @(_mode == Mode.Panning || _mode == Mode.TemporaryPan ? "modeler-cursor-pan" : "") @(_activeSegmentAxis == 'V' ? "modeler-cursor-ns" : _activeSegmentAxis == 'H' ? "modeler-cursor-ew" : "")"
                 tabindex="0"
                 role="application"
                 aria-label="Workflow diagram"
                 @onpointerdown="OnPointerDown"
                 @onmodelerpointermove="_pointerMoveCallback"
                 @onpointerup="OnPointerUp"
                 @onpointerleave="OnPointerUp"
                 @onpointercancel="OnPointerCancel"
                 @onwheel="OnMouseWheel"
                 @onwheel:preventDefault
                 @onblur="OnCanvasBlur"
                 @oncontextmenu:preventDefault>

                <svg viewBox="@Session.ViewBox" width="100%" height="100%" style="display: block;">
                    <defs>
                        <pattern id="g2-grid" width="50" height="50" patternUnits="userSpaceOnUse">
                            <circle cx="2" cy="2" r="1" fill="var(--md-grid-dot)" />
                        </pattern>
                        <marker id="g2-arrowhead" markerWidth="6" markerHeight="4.5" refX="5" refY="2.25" orient="auto">
                            <polygon points="0 0, 6 2.25, 0 4.5" fill="currentColor" />
                        </marker>
                    </defs>

                    <rect x="@Session.PanX" y="@Session.PanY"
                          width="@(Session.CanvasWidth / Session.Zoom)"
                          height="@(Session.CanvasHeight / Session.Zoom)"
                          fill="url(#g2-grid)" />

                    @* Connections *@
                    @foreach (var conn in State.Connections)
                    {
                        var wps = conn.Waypoints;
                        if (wps.Count < 2) continue;
                        var isSel = State.SelectedConnection == conn;
                        var path = RoutingService.WaypointsToSvgPath(wps);
                        var isUserActivity = conn.Source.NodeData is UserActivity;
                        var isDefault = conn.EngineConnection.IsDefault;
                        var connLabel = GetConnectionLabel(conn);
                        var hitWidth = 14.0 / Session.Zoom;
                        var routingSuspended = conn.RouteSuspended;
                        var isInsertTarget = ReferenceEquals(_insertionTarget, conn);
                        var connClasses = "modeler-conn"
                            + (isSel ? " modeler-conn-selected" : "")
                            + (isDefault ? " modeler-conn-default" : "")
                            + (routingSuspended ? " modeler-conn-routing-suspended" : "")
                            + (isInsertTarget ? " modeler-conn-insert-target" : "");
                        <g class="@connClasses"
                           @onpointerdown:stopPropagation>

                            <path d="@path" stroke="transparent" stroke-width="@hitWidth" fill="none"
                                  style="cursor: pointer;"
                                  @onpointerdown="e => OnConnectionPointerDown(e, conn)" />

                            <path d="@path" class="modeler-conn-path" fill="none"
                                  marker-end="url(#g2-arrowhead)" />

                            @if (!string.IsNullOrEmpty(connLabel))
                            {
                                var anchor = GetLabelAnchor(wps);
                                var half = LabelHalfWidth(connLabel);
                                var labelClass = isDefault
                                    ? "modeler-conn-label modeler-conn-label-default"
                                    : isUserActivity
                                        ? "modeler-conn-label modeler-conn-label-action"
                                        : "modeler-conn-label";
                                @* The plate keeps the label readable over connectors, bends and
                                   arrowheads after a reroute. *@
                                <g class="modeler-conn-label-plate"
                                   transform="translate(@anchor.X.ToString("F2", CultureInfo.InvariantCulture), @anchor.Y.ToString("F2", CultureInfo.InvariantCulture))">
                                    <rect x="@(-half)" y="-11" width="@(half * 2)" height="16" rx="4" class="modeler-conn-label-bg" />
                                    <text x="0" y="0" text-anchor="middle" class="@labelClass">@connLabel</text>
                                </g>
                            }

                            @if (isSel && !EffectiveReadOnly)
                            {
                                for (int i = 0; i < wps.Count; i++)
                                {
                                    var idx = i; // the loop variable is shared across iterations; lambdas must capture a copy
                                    var isEndpoint = idx == 0 || idx == wps.Count - 1;
                                    <circle cx="@wps[idx].X" cy="@wps[idx].Y" r="@(5.0 / Session.Zoom)"
                                            class="modeler-waypoint @(isEndpoint ? "modeler-waypoint-endpoint" : "")"
                                            @onpointerdown:stopPropagation
                                            @onpointerdown="e => OnWaypointPointerDown(e, conn, idx)" />
                                }
                            }
                        </g>
                    }

                    @* Draft connection *@
                    @if (_draftConnection != null)
                    {
                        var draftPath = _draftConnection.FixedEndIsTarget
                            ? RoutingService.DraftPathToTarget(
                                _draftConnection.FixedNode, _draftConnection.FixedDir,
                                _draftConnection.MouseX, _draftConnection.MouseY,
                                _draftConnection.TargetHint)
                            : RoutingService.DraftPath(
                                _draftConnection.FixedNode, _draftConnection.FixedDir,
                                _draftConnection.MouseX, _draftConnection.MouseY,
                                _draftConnection.TargetHint);
                        <path d="@draftPath"
                              class="modeler-draft-path @(_draftConnection.TargetHint != null ? "modeler-draft-valid" : "")"
                              marker-end="url(#g2-arrowhead)" />
                    }

                    @* Outline of the node a connection would attach to on release *@
                    @if (_draftConnection?.TargetHint is DesignerNode dropHint)
                    {
                        <rect x="@dropHint.X" y="@dropHint.Y" width="@dropHint.Width" height="@dropHint.Height"
                              class="modeler-drop-target" />
                    }

                    @* Axis the dragged segment is allowed to move on *@
                    @if (_activeSegmentAxis is 'H' or 'V' && _segmentGuide is { } segmentGuide)
                    {
                        if (_activeSegmentAxis == 'H')
                        {
                            <line class="modeler-segment-guide"
                                  x1="@Session.PanX" y1="@segmentGuide"
                                  x2="@(Session.PanX + Session.CanvasWidth / Session.Zoom)" y2="@segmentGuide" />
                        }
                        else
                        {
                            <line class="modeler-segment-guide"
                                  x1="@segmentGuide" y1="@Session.PanY"
                                  x2="@segmentGuide" y2="@(Session.PanY + Session.CanvasHeight / Session.Zoom)" />
                        }
                    }

                    @* Pending node preview *@
                    @if (_pendingNodeDesc != null)
                    {
                        <g transform="translate(@_pendingNodeX, @_pendingNodeY)" class="modeler-pending-node">
                            @switch (_pendingNodeShape)
                            {
                                case NodeShape.Circle:
                                    <ellipse cx="@(_pendingNodeW / 2)" cy="@(_pendingNodeH / 2)"
                                             rx="@(_pendingNodeW / 2)" ry="@(_pendingNodeH / 2)"
                                             class="modeler-node-shape @_pendingNodeCss" />
                                    break;
                                case NodeShape.Diamond:
                                    <polygon points="@($"{_pendingNodeW / 2},0 {_pendingNodeW},{_pendingNodeH / 2} {_pendingNodeW / 2},{_pendingNodeH} 0,{_pendingNodeH / 2}")"
                                             class="modeler-node-shape @_pendingNodeCss" />
                                    break;
                                default:
                                    <rect x="0" y="0" width="@_pendingNodeW" height="@_pendingNodeH" rx="6"
                                          class="modeler-node-shape @_pendingNodeCss" />
                                    break;
                            }
                            <text x="@(_pendingNodeW / 2)" y="@(_pendingNodeH / 2 + 4)" text-anchor="middle"
                                  class="modeler-node-label" dominant-baseline="middle">@_pendingNodeTitle</text>
                        </g>
                    }

                    @* Snap guides *@
                    @if (_snapResult?.TargetNode != null)
                    {
                        <g class="modeler-snap-guides">
                            <rect x="@(_snapResult.TargetNode.X - SnapHighlightPadding)"
                                  y="@(_snapResult.TargetNode.Y - SnapHighlightPadding)"
                                  width="@(_snapResult.TargetNode.Width + SnapHighlightPadding * 2)"
                                  height="@(_snapResult.TargetNode.Height + SnapHighlightPadding * 2)"
                                  class="modeler-snap-highlight" />

                            @if (_snapResult.XSnapAxis != null && _anchorNode != null)
                            {
                                double x = _snapResult.XSnapAxis switch
                                {
                                    SnapAxis.Start => _snapResult.SnappedX,
                                    SnapAxis.Center => _snapResult.SnappedX + _anchorNode.Width / 2,
                                    SnapAxis.End => _snapResult.SnappedX + _anchorNode.Width,
                                    _ => _snapResult.SnappedX
                                };

                                double top = Math.Min(_snapResult.SnappedY, _snapResult.TargetNode.Y) - 1000;
                                double bottom = Math.Max(_snapResult.SnappedY + _anchorNode.Height, _snapResult.TargetNode.Y + _snapResult.TargetNode.Height) + 1000;

                                <line x1="@x" y1="@top" x2="@x" y2="@bottom" class="modeler-snap-line" />
                            }

                            @if (_snapResult.YSnapAxis != null && _anchorNode != null)
                            {
                                double y = _snapResult.YSnapAxis switch
                                {
                                    SnapAxis.Start => _snapResult.SnappedY,
                                    SnapAxis.Center => _snapResult.SnappedY + _anchorNode.Height / 2,
                                    SnapAxis.End => _snapResult.SnappedY + _anchorNode.Height,
                                    _ => _snapResult.SnappedY
                                };

                                double left = Math.Min(_snapResult.SnappedX, _snapResult.TargetNode.X) - 20;
                                double right = Math.Max(_snapResult.SnappedX + _anchorNode.Width, _snapResult.TargetNode.X + _snapResult.TargetNode.Width) + 20;

                                <line x1="@left" y1="@y" x2="@right" y2="@y" class="modeler-snap-line" />
                            }
                        </g>
                    }

                    @* Rubber band selection *@
                    @if (_mode == Mode.Selecting)
                    {
                        double rx = Math.Min(_selStartX, _selEndX);
                        double ry = Math.Min(_selStartY, _selEndY);
                        double rw = Math.Abs(_selEndX - _selStartX);
                        double rh = Math.Abs(_selEndY - _selStartY);
                        <rect x="@rx" y="@ry" width="@rw" height="@rh"
                              class="modeler-rubber-band" />
                    }

                    @* Space tool guide *@
                    @if (_mode == Mode.SpaceTool && _spaceDirectionLocked)
                    {
                        var vpTop = Session.PanY;
                        var vpBottom = Session.PanY + Session.CanvasHeight / Session.Zoom;
                        var vpLeft = Session.PanX;
                        var vpRight = Session.PanX + Session.CanvasWidth / Session.Zoom;

                        @if (_spaceIsHorizontal)
                        {
                            @* horizontal drag → vertical cut line *@
                            <line class="modeler-space-guide"
                                  x1="@_spaceStartX" y1="@vpTop"
                                  x2="@_spaceStartX" y2="@vpBottom" />
                        }
                        else
                        {
                            @* vertical drag → horizontal cut line *@
                            <line class="modeler-space-guide"
                                  x1="@vpLeft" y1="@_spaceStartY"
                                  x2="@vpRight" y2="@_spaceStartY" />
                        }
                    }

                    @* Space tool crosshair *@
                    @if (_activeTool == ActiveTool.AddSpace && _mode == Mode.Idle)
                    {
                        var vpTop = Session.PanY;
                        var vpBottom = Session.PanY + Session.CanvasHeight / Session.Zoom;
                        var vpLeft = Session.PanX;
                        var vpRight = Session.PanX + Session.CanvasWidth / Session.Zoom;

                        <line class="modeler-space-crosshair" x1="@vpLeft" y1="@_spaceCursorY"
                              x2="@vpRight" y2="@_spaceCursorY" />
                        <line class="modeler-space-crosshair" x1="@_spaceCursorX" y1="@vpTop"
                              x2="@_spaceCursorX" y2="@vpBottom" />
                    }

                    @* Pools + Swimlanes (background, below nodes) *@
                    @foreach (var pool in State.Pools)
                    {
                        var pSel = State.SelectedPool == pool;
                        const double headerW = 40;
                        <g class="pool-group @(pSel ? "pool-selected" : "")">
                            <rect class="pool-bg" x="@pool.X.ToString("F2", CultureInfo.InvariantCulture)"
                                  y="@pool.Y.ToString("F2", CultureInfo.InvariantCulture)"
                                  width="@pool.Width.ToString("F2", CultureInfo.InvariantCulture)"
                                  height="@pool.Height.ToString("F2", CultureInfo.InvariantCulture)" />
                            @* Header strip *@
                            <rect class="pool-header" x="@pool.X.ToString("F2", CultureInfo.InvariantCulture)"
                                  y="@pool.Y.ToString("F2", CultureInfo.InvariantCulture)"
                                  width="@headerW" height="@pool.Height.ToString("F2", CultureInfo.InvariantCulture)"
                                  @onpointerdown="e => OnPoolHeaderPointerDown(e, pool)" @onpointerdown:stopPropagation />
                            <text class="pool-header-label"
                                  transform="translate(@((pool.X + headerW / 2).ToString("F2", CultureInfo.InvariantCulture)),@((pool.Y + pool.Height / 2).ToString("F2", CultureInfo.InvariantCulture))) rotate(-90)">
                                @pool.Data.Label
                            </text>

                            @foreach (var lane in State.Lanes.Where(l => l.Pool == pool).OrderBy(l => l.Data.Order))
                            {
                                var lSel = State.SelectedLane == lane;
                                <g class="swimlane-group @(lSel ? "lane-selected" : "")">
                                    <rect class="swimlane-bg"
                                          x="@lane.X.ToString("F2", CultureInfo.InvariantCulture)"
                                          y="@lane.Y.ToString("F2", CultureInfo.InvariantCulture)"
                                          width="@lane.Width.ToString("F2", CultureInfo.InvariantCulture)"
                                          height="@lane.Height.ToString("F2", CultureInfo.InvariantCulture)" />
                                    @* Lane header strip — clicking the header selects the lane *@
                                    <rect class="swimlane-header"
                                          x="@lane.X.ToString("F2", CultureInfo.InvariantCulture)"
                                          y="@lane.Y.ToString("F2", CultureInfo.InvariantCulture)"
                                          width="@headerW" height="@lane.Height.ToString("F2", CultureInfo.InvariantCulture)"
                                          @onpointerdown="e => OnLaneHeaderPointerDown(e, lane)" @onpointerdown:stopPropagation />
                                    <text class="swimlane-label"
                                          transform="translate(@((lane.X + headerW / 2).ToString("F2", CultureInfo.InvariantCulture)),@((lane.Y + lane.Height / 2).ToString("F2", CultureInfo.InvariantCulture))) rotate(-90)"
                                          @onpointerdown="e => OnLaneHeaderPointerDown(e, lane)" @onpointerdown:stopPropagation>
                                        @lane.Data.Label
                                    </text>
                                    @{
                                        var role = lane.Data.RoleId.HasValue
                                            ? State.Roles.FirstOrDefault(r => r.Id == lane.Data.RoleId)
                                            : null;
                                    }
                                    @if (role != null)
                                    {
                                        <g>
                                            <text class="swimlane-role-badge"
                                                  x="@((lane.X + headerW + 4).ToString("F2", CultureInfo.InvariantCulture))"
                                                  y="@((lane.Y + 14).ToString("F2", CultureInfo.InvariantCulture))">
                                                @role.Name
                                            </text>
                                        </g>
                                    }
                                </g>
                            }

                            @* Lane resize handles (dividers between lanes) *@
                            @{
                                var orderedLanes = State.Lanes.Where(l => l.Pool == pool).OrderBy(l => l.Data.Order).ToList();
                            }
                            @if (!EffectiveReadOnly)
                            {
                                @for (int li = 0; li < orderedLanes.Count - 1; li++)
                                {
                                    var topLane = orderedLanes[li];
                                    var botLane = orderedLanes[li + 1];
                                    var divY = topLane.Y + topLane.Height;
                                    var captureTop = topLane;
                                    var captureBot = botLane;
                                    <line class="swimlane-divider-handle"
                                          x1="@((pool.X + headerW).ToString("F2", CultureInfo.InvariantCulture))" y1="@divY.ToString("F2", CultureInfo.InvariantCulture)"
                                          x2="@((pool.X + pool.Width).ToString("F2", CultureInfo.InvariantCulture))" y2="@divY.ToString("F2", CultureInfo.InvariantCulture)"
                                          @onpointerdown="e => OnLaneDividerPointerDown(e, captureTop, captureBot)" @onpointerdown:stopPropagation />
                                }
                            }

                            @* Pool resize handles — right edge, bottom edge, SE corner *@
                            @if (!EffectiveReadOnly)
                            {
                                <rect class="pool-resize-handle pool-resize-e"
                                      x="@((pool.X + pool.Width - 6).ToString("F2", CultureInfo.InvariantCulture))"
                                      y="@pool.Y.ToString("F2", CultureInfo.InvariantCulture)"
                                      width="12" height="@((pool.Height - 12).ToString("F2", CultureInfo.InvariantCulture))"
                                      @onpointerdown="e => OnPoolResizePointerDown(e, pool, true, false)"
                                      @onpointerdown:stopPropagation />
                                <rect class="pool-resize-handle pool-resize-s"
                                      x="@pool.X.ToString("F2", CultureInfo.InvariantCulture)"
                                      y="@((pool.Y + pool.Height - 6).ToString("F2", CultureInfo.InvariantCulture))"
                                      width="@((pool.Width - 12).ToString("F2", CultureInfo.InvariantCulture))" height="12"
                                      @onpointerdown="e => OnPoolResizePointerDown(e, pool, false, true)"
                                      @onpointerdown:stopPropagation />
                                <rect class="pool-resize-handle pool-resize-se"
                                      x="@((pool.X + pool.Width - 8).ToString("F2", CultureInfo.InvariantCulture))"
                                      y="@((pool.Y + pool.Height - 8).ToString("F2", CultureInfo.InvariantCulture))"
                                      width="14" height="14"
                                      @onpointerdown="e => OnPoolResizePointerDown(e, pool, true, true)"
                                      @onpointerdown:stopPropagation />
                            }
                        </g>
                    }

                    @* Nodes *@
                    @foreach (var node in State.Nodes)
                    {
                        var isSel = State.SelectedNodes.Contains(node);
                        var isHighlighted = _highlightedNodeId.HasValue && node.NodeData.Id == _highlightedNodeId.Value;
                        var isDropTarget = ReferenceEquals(_draftConnection?.TargetHint, node);
                        var handleSize = 4.0 / Session.Zoom;

                        @* Pointer-down on nodes is handled by the canvas hit-test in OnPointerDown;
                           a second handler here would race it across the JS-interop awaits. *@
                        <g class="modeler-node @(isSel ? "modeler-node-selected" : "") @(isHighlighted ? "modeler-node-highlighted" : "") @(isDropTarget ? "modeler-node-drop-target" : "")"
                           transform="translate(@node.X.ToString("F2", CultureInfo.InvariantCulture), @node.Y.ToString("F2", CultureInfo.InvariantCulture))"
                           @ondblclick="() => OnNodeDoubleClick(node)">

                            @switch (node.Shape)
                            {
                                case NodeShape.Circle:
                                    <ellipse cx="@(node.Width / 2)" cy="@(node.Height / 2)"
                                             rx="@(node.Width / 2)" ry="@(node.Height / 2)"
                                             class="modeler-node-shape @node.CssClass" />
                                    break;
                                case NodeShape.Diamond:
                                    var _gdw = node.Width; var _gdh = node.Height;
                                    var _gcx = _gdw / 2.0; var _gcy = _gdh / 2.0;
                                    var _ghs = Math.Min(_gdw, _gdh) * 0.17;
                                    <polygon points="@($"{(_gdw / 2).ToString("F2", CultureInfo.InvariantCulture)},0 {_gdw.ToString("F2", CultureInfo.InvariantCulture)},{(_gdh / 2).ToString("F2", CultureInfo.InvariantCulture)} {(_gdw / 2).ToString("F2", CultureInfo.InvariantCulture)},{_gdh.ToString("F2", CultureInfo.InvariantCulture)} 0,{(_gdh / 2).ToString("F2", CultureInfo.InvariantCulture)}")"
                                             class="modeler-node-shape @node.CssClass" />
                                    @if (node.NodeData is ExclusiveGateway)
                                    {
                                        <line class="modeler-gw-symbol" x1="@(_gcx - _ghs)" y1="@(_gcy - _ghs)" x2="@(_gcx + _ghs)" y2="@(_gcy + _ghs)" />
                                        <line class="modeler-gw-symbol" x1="@(_gcx + _ghs)" y1="@(_gcy - _ghs)" x2="@(_gcx - _ghs)" y2="@(_gcy + _ghs)" />
                                    }
                                    else if (node.NodeData is ParallelGateway)
                                    {
                                        <line class="modeler-gw-symbol" x1="@_gcx" y1="@(_gcy - _ghs)" x2="@_gcx" y2="@(_gcy + _ghs)" />
                                        <line class="modeler-gw-symbol" x1="@(_gcx - _ghs)" y1="@_gcy" x2="@(_gcx + _ghs)" y2="@_gcy" />
                                    }
                                    else if (node.NodeData is InclusiveGateway)
                                    {
                                        <circle class="modeler-gw-symbol" cx="@_gcx" cy="@_gcy" r="@_ghs" />
                                    }
                                    break;
                                default:
                                    <rect x="0" y="0" width="@node.Width" height="@node.Height" rx="6"
                                          class="modeler-node-shape @node.CssClass" />
                                    break;
                            }

                            @* Analog clock for timer nodes *@
                            @if (node.NodeData is CatchingTimerEvent or TimerBoundaryEvent)
                            {
                                var _ckCx = node.Width / 2.0;
                                var _ckCy = node.Height / 2.0;
                                var _ckR  = Math.Min(node.Width, node.Height) / 2.0 - 5.0;
                                var _ckHL = _ckR * 0.50;
                                var _ckML = _ckR * 0.73;
                                var _ckSL = _ckR * 0.84;
                                var _ckBig  = Math.Min(node.Width, node.Height) >= 70;

                                <g class="clock-overlay"
                                   transform="translate(@_ckCx.ToString("F2", CultureInfo.InvariantCulture), @_ckCy.ToString("F2", CultureInfo.InvariantCulture))">

                                    @for (int _t = 0; _t < 12; _t++)
                                    {
                                        var _ta  = _t * 30.0 * Math.PI / 180.0;
                                        var _maj = _t % 3 == 0;
                                        var _oR  = _ckR - 0.5;
                                        var _iR  = _ckR - (_maj ? 4.5 : 2.5);
                                        <line class="@(_maj ? "clock-tick-major" : "clock-tick")"
                                              x1="@((Math.Sin(_ta) * _iR).ToString("F2", CultureInfo.InvariantCulture))"
                                              y1="@((-Math.Cos(_ta) * _iR).ToString("F2", CultureInfo.InvariantCulture))"
                                              x2="@((Math.Sin(_ta) * _oR).ToString("F2", CultureInfo.InvariantCulture))"
                                              y2="@((-Math.Cos(_ta) * _oR).ToString("F2", CultureInfo.InvariantCulture))" />
                                    }

                                    <line class="clock-hand clock-hand-hour" x1="0" y1="0"
                                          x2="0" y2="@((-_ckHL).ToString("F2", CultureInfo.InvariantCulture))" />
                                    <line class="clock-hand clock-hand-minute" x1="0" y1="0"
                                          x2="0" y2="@((-_ckML).ToString("F2", CultureInfo.InvariantCulture))" />
                                    @if (_ckBig)
                                    {
                                        <line class="clock-hand clock-hand-second"
                                              x1="0" y1="@((_ckSL * 0.22).ToString("F2", CultureInfo.InvariantCulture))"
                                              x2="0" y2="@((-_ckSL).ToString("F2", CultureInfo.InvariantCulture))" />
                                    }
                                    <circle r="2" class="clock-center" />
                                </g>
                            }

                            @if (node.Shape == NodeShape.Diamond)
                            {
                                <svg:text x="@(node.Width / 2)" y="@(node.Height + 14)"
                                          text-anchor="middle" class="modeler-node-label"
                                          dominant-baseline="middle">@node.Title</svg:text>
                            }
                            else if (node.NodeData is not (CatchingTimerEvent or TimerBoundaryEvent))
                            {
                                <svg:text x="@(node.Width / 2)" y="@(node.Height / 2 + 4)"
                                          text-anchor="middle" class="modeler-node-label"
                                          dominant-baseline="middle">@node.Title</svg:text>
                            }

                            @* Anchors *@
                            @if (!EffectiveReadOnly && (isSel || isDropTarget))
                            {
                                var anchors = AnchorService.GetAnchors(node);
                                foreach (var a in anchors)
                                {
                                    var anchorDir = a.dir;
                                    <circle cx="@(a.X - node.X)" cy="@(a.Y - node.Y)" r="@(6.0 / Session.Zoom)"
                                            class="modeler-anchor"
                                            @onpointerdown:stopPropagation
                                            @onpointerdown="e => OnAnchorPointerDown(e, node, anchorDir)" />
                                }
                            }

                            @* Resize handles *@
                            @if (!EffectiveReadOnly && isSel && node.Shape != NodeShape.Circle)
                            {
                                var h = handleSize;
                                <rect x="0" y="@(-h)" width="@node.Width" height="@(h * 2)" fill="transparent"
                                      style="cursor: ns-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.TopEdge)" />
                                <rect x="@(node.Width - h)" y="0" width="@(h * 2)" height="@node.Height" fill="transparent"
                                      style="cursor: ew-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.RightEdge)" />
                                <rect x="0" y="@(node.Height - h)" width="@node.Width" height="@(h * 2)" fill="transparent"
                                      style="cursor: ns-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.BottomEdge)" />
                                <rect x="@(-h)" y="0" width="@(h * 2)" height="@node.Height" fill="transparent"
                                      style="cursor: ew-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.LeftEdge)" />

                                <rect x="@(-h)" y="@(-h)" width="@(h * 2)" height="@(h * 2)" fill="transparent"
                                      style="cursor: nwse-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.TopLeft)" />
                                <rect x="@(node.Width - h)" y="@(-h)" width="@(h * 2)" height="@(h * 2)" fill="transparent"
                                      style="cursor: nesw-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.TopRight)" />
                                <rect x="@(-h)" y="@(node.Height - h)" width="@(h * 2)" height="@(h * 2)" fill="transparent"
                                      style="cursor: nesw-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.BottomLeft)" />
                                <rect x="@(node.Width - h)" y="@(node.Height - h)" width="@(h * 2)" height="@(h * 2)" fill="transparent"
                                      style="cursor: nwse-resize;"
                                      @onpointerdown:stopPropagation
                                      @onpointerdown="e => OnResizeStart(e, node, GeometryEditor.ResizeEdges.BottomRight)" />
                            }
                        </g>
                    }
                </svg>

                @if (_showShortcuts)
                {
                    <div class="modeler-shortcuts" role="dialog" aria-label="Keyboard shortcuts">
                        <div class="modeler-shortcuts-title">Keyboard shortcuts</div>
                        @foreach (var (keys, description) in ShortcutHelp)
                        {
                            <div class="modeler-shortcut-row">
                                <kbd>@keys</kbd>
                                <span>@description</span>
                            </div>
                        }
                        <button class="modeler-menu-item" @onclick="() => _showShortcuts = false">Close</button>
                    </div>
                }
            </div>

            @if (_editingNode != null)
            {
                <div class="modeler-resizer modeler-resizer-v"
                     data-resize-prop="--properties-height"
                     data-resize-axis="y"
                     data-resize-invert="true"
                     data-resize-min="80"></div>
                <ModelerPropertiesPanel Node="_editingNode"
                                        State="@State"
                                        Registry="@Registry"
                                        ReadOnly="@EffectiveReadOnly"
                                        OnClose="@ClosePropertiesPanel" />
            }
            else if (!EffectiveReadOnly && State.SelectedConnection is { } selectedConn)
            {
                <div class="modeler-resizer modeler-resizer-v"
                     data-resize-prop="--properties-height"
                     data-resize-axis="y"
                     data-resize-invert="true"
                     data-resize-min="80"></div>
                <ConnectionEditorPanel Connection="@selectedConn"
                                       State="@State"
                                       OnClose="@CloseConnectionEditor" />
            }
            else if (!EffectiveReadOnly && (State.SelectedPool != null || State.SelectedLane != null))
            {
                <div class="modeler-resizer modeler-resizer-v"
                     data-resize-prop="--properties-height"
                     data-resize-axis="y"
                     data-resize-invert="true"
                     data-resize-min="80"></div>
                <PoolLanePropertiesPanel State="@State" />
            }
            </div>

            <div class="modeler-resizer modeler-resizer-h"
                 data-resize-prop="--sidebar-width"
                 data-resize-axis="x"
                 data-resize-invert="true"
                 data-resize-min="200"></div>
            <ModelerSidebar State="@State"
                            OnHoverNode="OnSidebarHoverNode"
                            OnVersionLoaded="OnVersionLoaded"
                            OnFocusNode="FocusNode" />
        </div>
    </div>
</div>
