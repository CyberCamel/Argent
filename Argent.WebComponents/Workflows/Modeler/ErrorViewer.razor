@using Argent.WebComponents.Workflows.Modeler
@using Argent.Core.Workflows
<div class="bg-surface rounded-xl border border-line mb-4 overflow-hidden">
    <div class="px-4 py-3 bg-sunken border-b border-line">
        <h3 class="text-base font-semibold text-ink-heading flex items-center">
            <i class="bi bi-heart-pulse text-accent-text mr-2"></i> Workflow Health
        </h3>
    </div>
    <div class="p-4">

        <div class="mb-4">
            <h4 class="text-sm font-semibold text-danger uppercase tracking-wider mb-2 flex items-center">
                <i class="bi bi-x-circle-fill mr-2"></i> Errors: @(State.ValidationResult?.Errors.Count() ?? 0)
            </h4>
            
            @if (State.ValidationResult?.Errors.Any() ?? false)
            {
                <div class="alert alert-danger overflow-hidden" role="alert">
                    <ul class="divide-y divide-red-200 dark:divide-red-800">
                        @foreach (var error in State.ValidationResult.Errors)
                        {
                            var node = error.Node;
                            <li class="modeler-error-item modeler-error-item-danger"
                                @onpointerenter="() => OnItemHover(node)"
                                @onpointerleave="() => OnItemHover(null)"
                                @onclick="() => OnItemClick(node)">
                                @if (node != null)
                                {
                                    <span class="modeler-error-node">@node.Name</span>
                                }
                                <span>@error.Message</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p class="text-ink-muted text-sm ml-4">No errors detected.</p>
            }
        </div>

        <div>
            <h4 class="text-sm font-semibold text-warning uppercase tracking-wider mb-2 flex items-center">
                <i class="bi bi-exclamation-triangle-fill mr-2"></i> Warnings: @(State.ValidationResult?.Warnings.Count() ?? 0)
            </h4>

            @if (State.ValidationResult?.Warnings.Any() ?? false)
            {
                <div class="alert alert-warning overflow-hidden" role="alert">
                    <ul class="divide-y divide-yellow-200 dark:divide-yellow-800">
                        @foreach (var warning in State.ValidationResult.Warnings)
                        {
                            var node = warning.Node;
                            <li class="modeler-error-item modeler-error-item-warning"
                                @onpointerenter="() => OnItemHover(node)"
                                @onpointerleave="() => OnItemHover(null)"
                                @onclick="() => OnItemClick(node)">
                                @if (node != null)
                                {
                                    <span class="modeler-error-node">@node.Name</span>
                                }
                                <span>@warning.Message</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <p class="text-ink-muted text-sm ml-4">No warnings detected.</p>
            }
        </div>

    </div>
</div>

@code {
    [Parameter] public required DesignerService State { get; set; }
    [Parameter] public EventCallback<NodeBase?> OnHoverNode { get; set; }
    [Parameter] public EventCallback<NodeBase> OnFocusNode { get; set; }

    private async Task OnItemHover(NodeBase? node) => await OnHoverNode.InvokeAsync(node);

    /// <summary>Selecting an entry also frames the node, so the user sees what it refers to.</summary>
    private async Task OnItemClick(NodeBase? node)
    {
        if (node == null) return;
        var designerNode = State.Nodes.FirstOrDefault(n => n.NodeData == node);
        if (designerNode != null) State.SelectNodes([designerNode], designerNode);
        await OnFocusNode.InvokeAsync(node);
    }
}