@using Argent.Core.DomainObjects
@using Argent.Core.DataSources
@using Argent.WebComponents.DomainObjects.Designer
@using Microsoft.JSInterop
@implements IDisposable
@inject DomainObjectDesignerService State
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IStringLocalizer<SharedResource> Localizer


<div class="flex flex-col h-full">
    @* ── Toolbar ─────────────────────────────────────────────── *@
    <div class="flex items-center gap-2 p-2 border-b bg-surface" style="min-height: 42px;">
        <a href="/DomainObjects" class="btn btn-secondary btn-sm mr-1" title="@Localizer["DomainObjectDesigner.Back"]">
            <i class="bi bi-arrow-left"></i>
        </a>
        <input type="text" class="form-input form-input-sm" style="max-width: 220px;"
               value="@State.Name"
               @onchange="e => { State.Name = e.Value?.ToString() ?? string.Empty; State.MarkDirty(); }"
               placeholder="@Localizer["DomainObjectDesigner.ObjectNamePlaceholder"]" />
        <input type="text" class="form-input form-input-sm do-key" style="max-width: 180px;"
               value="@State.Key"
               disabled="@(!State.IsNew)"
               @onchange="e => { State.Key = e.Value?.ToString() ?? string.Empty; State.MarkDirty(); }"
               placeholder="@Localizer["DomainObjectDesigner.ObjectKeyPlaceholder"]" title="Stable system key (immutable once saved)" />

        @if (!State.IsReadOnly)
        {
            <button class="btn btn-accent-secondary btn-sm" @onclick="HandleSave" disabled="@_isBusy">
                <i class="bi bi-save-fill"></i> @Localizer["DomainObjectDesigner.SaveDraft"]
            </button>
            <button class="btn btn-success-secondary btn-sm" @onclick="HandlePublish" disabled="@_isBusy">
                <i class="bi bi-cloud-arrow-up-fill"></i> Publish
            </button>
            <span title="@(State.HasUnsavedChanges ? Localizer["DomainObjectDesigner.UnsavedChanges"] : Localizer["DomainObjectDesigner.Saved"])"
                  class="@(State.HasUnsavedChanges ? "text-warning" : "text-success")">
                <i class="bi @(State.HasUnsavedChanges ? "bi-circle-fill" : "bi-check-circle-fill")"></i>
            </span>
            @if (!string.IsNullOrEmpty(State.PublishedVersion))
            {
                <span class="badge badge-neutral" title="Latest published version">v@(State.PublishedVersion)</span>
            }
        }
        else
        {
            <span class="badge badge-warning">
                <i class="bi bi-eye-fill mr-1"></i> Read-only view
            </span>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <span class="text-danger text-sm ml-2"><i class="bi bi-exclamation-triangle-fill"></i> @_error</span>
        }
    </div>

    <div class="flex flex-1 overflow-hidden">
        @* ── Property list ───────────────────────────────────── *@
        <div class="flex-1 overflow-auto p-3">
            <div class="flex items-center mb-2">
                <h6 class="text-ink-muted mb-0"><i class="bi bi-list-columns-reverse"></i> @Localizer["DomainObjectDesigner.Properties"]</h6>
                <button class="btn btn-accent-secondary btn-sm ml-auto" @onclick="() => State.AddProperty()">
                    <i class="bi bi-plus-lg"></i> @Localizer["DomainObjectDesigner.AddProperty"]
                </button>
            </div>

            @if (State.Definition.Properties.Count == 0)
            {
                <div class="text-ink-muted border rounded p-4 text-center" style="border-style: dashed !important;">
                    @Localizer["DomainObjectDesigner.NoProperties"]
                </div>
            }
            else
            {
                <div class="w-full overflow-x-auto border border-line rounded-lg">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-line bg-sunken">
                            <th class="px-3 py-2 text-left font-semibold text-ink-muted" style="width: 28px;"></th>
                            <th class="px-3 py-2 text-left font-semibold text-ink-muted">@Localizer["DomainObjectDesigner.KeyColumn"]</th>
                            <th class="px-3 py-2 text-left font-semibold text-ink-muted">@Localizer["DomainObjectDesigner.DisplayName"]</th>
                            <th class="px-3 py-2 text-left font-semibold text-ink-muted">@Localizer["Common.Type"]</th>
                            <th class="px-3 py-2 text-left font-semibold text-ink-muted">Flags</th>
                            <th class="px-3 py-2 text-right font-semibold text-ink-muted" style="width: 110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in State.Definition.Properties)
                        {
                            <tr class="do-row border-b border-line-subtle @(ReferenceEquals(row, State.SelectedProperty) ? "selected" : "")"
                                @onclick="() => State.SelectProperty(row)">
                                <td class="px-3 py-2 text-ink-muted">
                                    @if (State.Definition.TitleProperty == row.Key)
                                    {
                                        <i class="bi bi-star-fill text-warning" title="@Localizer["DomainObjectDesigner.TitleProperty"]"></i>
                                    }
                                </td>
                                <td class="px-3 py-2 do-key">@row.Key</td>
                                <td class="px-3 py-2">@row.DisplayName</td>
                                <td class="px-3 py-2"><span class="badge badge-neutral">@row.Type</span></td>
                                <td class="px-3 py-2 text-sm text-ink-muted">
                                    @if (row.Required) { <span class="mr-1" title="Required">REQ</span> }
                                    @if (row.Unique) { <span class="mr-1" title="Unique">UNQ</span> }
                                    @if (row.Indexed) { <span class="mr-1" title="Indexed">IDX</span> }
                                    @if (row.IsCollection) { <span title="Collection">[]</span> }
                                </td>
                                <td class="px-3 py-2 text-right whitespace-nowrap" @onclick:stopPropagation>
                                    <button class="text-sm text-accent-text hover:underline p-0 bg-transparent border-none cursor-pointer mr-1" @onclick="() => State.MoveProperty(row, -1)" title="Move up"><i class="bi bi-arrow-up"></i></button>
                                    <button class="text-sm text-accent-text hover:underline p-0 bg-transparent border-none cursor-pointer mr-1" @onclick="() => State.MoveProperty(row, 1)" title="Move down"><i class="bi bi-arrow-down"></i></button>
                                    <button class="text-sm text-danger hover:underline p-0 bg-transparent border-none cursor-pointer" @onclick="() => State.RemoveProperty(row)" title="Delete"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }

            @* ── External data source bindings ─────────────────── *@
            <hr class="my-3" />
            <div class="flex items-center mb-2">
                <h6 class="text-ink-muted mb-0"><i class="bi bi-hdd-network"></i> External Data Sources</h6>
                <button class="btn btn-accent-secondary btn-sm ml-auto" @onclick="() => State.AddDataSource()">
                    <i class="bi bi-plus-lg"></i> Add Data Source
                </button>
            </div>
            <p class="text-ink-muted text-sm">Optional. Bind records to an external query; otherwise records come from managed storage. Referenced by index from a form dropdown's data provider.</p>

            @if (State.Definition.DataSources.Count == 0)
            {
                <div class="text-ink-muted border rounded p-3 text-center text-sm" style="border-style: dashed !important;">
                    No external bindings.
                </div>
            }
            else
            {
                @for (int dsI = 0; dsI < State.Definition.DataSources.Count; dsI++)
                {
                    var dsIndex = dsI;
                    var ds = State.Definition.DataSources[dsIndex];
                    <div class="border border-line rounded-lg mb-2 overflow-hidden">
                        <div class="flex items-center gap-2 py-1.5 px-3 bg-sunken border-b border-line">
                            <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium rounded bg-gray-500 text-white" title="DataSourceIndex">#@dsIndex</span>
                            <input class="form-input text-sm" style="max-width: 220px;"
                                   placeholder="Binding name" @bind="ds.Name" @bind:after="State.MarkDirty" />
                            <button class="ml-auto text-sm text-danger hover:underline p-0 bg-transparent border-none cursor-pointer"
                                    @onclick="() => State.RemoveDataSource(ds)" title="Remove binding">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="p-3">
                            <label class="property-label">Connection</label>
                            <select class="form-input text-sm mb-2" @bind="ds.DataSourceKey" @bind:after="State.MarkDirty">
                                <option value="">— select connection —</option>
                                @foreach (var conn in State.DataSourceCatalog)
                                {
                                    <option value="@conn.Key">@conn.Name (@conn.Kind)</option>
                                }
                            </select>
                            @if (State.DataSourceCatalog.Count == 0)
                            {
                                <div class="text-ink-muted text-sm mb-2">No connections defined — create them under <a href="/DataSources" target="_blank">Data Sources</a>.</div>
                            }

                            <label class="property-label">Query</label>
                            <textarea class="form-input text-sm font-mono mb-2" rows="2"
                                      placeholder="SELECT id, name FROM Customer" @bind="ds.Query" @bind:after="State.MarkDirty"></textarea>

                            <div class="flex items-center mb-1">
                                <span class="property-label mb-0">Column mappings</span>
                                <button class="ml-auto text-sm text-accent-text hover:underline p-0 bg-transparent border-none cursor-pointer" @onclick="() => State.AddColumnMapping(ds)">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </div>
                            @foreach (var mapping in ds.ColumnMappings)
                            {
                                <div class="input-group mb-1">
                                    <input class="form-input rounded-r-none" placeholder="result column" @bind="mapping.Column" @bind:after="State.MarkDirty" />
                                    <span class="input-group-text border-l-0 border-r-0">→</span>
                                    <select class="form-input rounded-l-none" @bind="mapping.Property" @bind:after="State.MarkDirty">
                                        <option value="">— property —</option>
                                        @foreach (var target in State.Definition.Properties)
                                        {
                                            <option value="@target.Key">@target.Key</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-danger-secondary btn-sm btn-appended"
                                            title="@Localizer["Common.Remove"]" aria-label="@Localizer["Common.Remove"]"
                                            @onclick="() => State.RemoveColumnMapping(ds, mapping)">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                            <div class="text-xs text-ink-muted mt-1">Unmapped columns fall through to a property with the same name.</div>
                        </div>
                    </div>
                }
            }
        </div>

        @* ── Sidebar (Properties / Versions) ─────────────────── *@
        <div class="border-s bg-sunken flex flex-col" style="width: 360px; min-width: 360px;">
            @* Tab bar *@
            <div class="flex border-b bg-surface">
                <button class="px-4 py-2 text-sm font-medium transition-colors @(_sidebarTab == "props" ? "border-b-2 border-accent-border text-accent-text" : "text-ink-muted hover:text-ink")"
                        @onclick='() => _sidebarTab = "props"'>
                    <i class="bi bi-list-columns-reverse mr-1"></i> @Localizer["DomainObjectDesigner.Properties"]
                </button>
                <button class="px-4 py-2 text-sm font-medium transition-colors @(_sidebarTab == "versions" ? "border-b-2 border-accent-border text-accent-text" : "text-ink-muted hover:text-ink")"
                        @onclick='() => _sidebarTab = "versions"'>
                    <i class="bi bi-clock-history mr-1"></i> @Localizer["DomainObjectDesigner.Versions"]
                    @if (State.Versions.Count > 0)
                    {
                        <span class="badge badge-neutral ml-1">@State.Versions.Count</span>
                    }
                </button>
            </div>
            @* Tab content *@
            <div class="flex-1 overflow-y-auto p-3">
            @if (_sidebarTab == "versions")
            {
                <DomainObjectVersioningPanel State="@State" OnVersionLoaded="StateHasChanged" />
            }
            else if (State.SelectedProperty is { } prop)
            {
                <h6 class="text-ink-muted mb-3"><i class="bi bi-sliders"></i> @Localizer["DomainObjectDesigner.Property"]</h6>

                <div class="property-section">
                    <div class="property-label">@Localizer["DomainObjectDesigner.PropertyKey"]</div>
                    <input class="form-input form-input-sm do-key mb-2" value="@prop.Key"
                           @onchange="e => { prop.Key = e.Value?.ToString() ?? string.Empty; State.MarkDirty(); }" />
                    <div class="property-label">@Localizer["DomainObjectDesigner.DisplayName"]</div>
                    <input class="form-input form-input-sm mb-2" @bind="prop.DisplayName" @bind:after="State.MarkDirty" />
                    <div class="property-label">@Localizer["Common.Description"]</div>
                    <input class="form-input form-input-sm" @bind="prop.Description" @bind:after="State.MarkDirty" />
                </div>

                <div class="property-section">
                    <div class="property-label">@Localizer["DomainObjectDesigner.DataType"]</div>
                    <select class="form-input text-sm mb-2" @bind="prop.Type" @bind:after="State.MarkDirty">
                        @foreach (var type in Enum.GetValues<DomainPropertyType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>

                    @if (prop.Type == DomainPropertyType.Reference)
                    {
                        <div class="property-label">@Localizer["DomainObjectDesigner.References"]</div>
                        <select class="form-input text-sm" @bind="prop.ReferenceTargetKey" @bind:after="State.MarkDirty">
                            <option value="">— select object —</option>
                            @foreach (var summary in State.Catalog.Where(s => s.Key != State.Key))
                            {
                                <option value="@summary.Key">@summary.Name (@summary.Key)</option>
                            }
                        </select>
                    }
                </div>

                <div class="property-section">
                    <div class="property-label">@Localizer["DomainObjectDesigner.Constraints"]</div>
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-line-strong bg-surface text-indigo-600 focus:ring-indigo-500" type="checkbox" id="p-req" @bind="prop.Required" @bind:after="State.MarkDirty" />
                        <label class="pl-2 text-sm text-ink cursor-pointer" for="p-req">@Localizer["DomainObjectDesigner.Required"]</label>
                    </div>
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-line-strong bg-surface text-indigo-600 focus:ring-indigo-500" type="checkbox" id="p-unq" @bind="prop.Unique" @bind:after="State.MarkDirty" />
                        <label class="pl-2 text-sm text-ink cursor-pointer" for="p-unq">@Localizer["DomainObjectDesigner.Unique"]</label>
                    </div>
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-line-strong bg-surface text-indigo-600 focus:ring-indigo-500" type="checkbox" id="p-idx" @bind="prop.Indexed" @bind:after="State.MarkDirty" />
                        <label class="pl-2 text-sm text-ink cursor-pointer" for="p-idx">@Localizer["DomainObjectDesigner.Indexed"]</label>
                    </div>
                    <div class="flex items-center">
                        <input class="h-4 w-4 rounded border-line-strong bg-surface text-indigo-600 focus:ring-indigo-500" type="checkbox" id="p-col" @bind="prop.IsCollection" @bind:after="State.MarkDirty" />
                        <label class="pl-2 text-sm text-ink cursor-pointer" for="p-col">@Localizer["DomainObjectDesigner.AllowMultiple"]</label>
                    </div>
                </div>

                @if (prop.Type == DomainPropertyType.Choice)
                {
                    <div class="property-section">
                        <div class="flex items-center mb-2">
                            <div class="property-label mb-0">@Localizer["DomainObjectDesigner.Choices"]</div>
                            <button class="ml-auto text-sm text-accent-text hover:underline p-0 bg-transparent border-none cursor-pointer" @onclick="() => AddChoice(prop)"><i class="bi bi-plus-lg"></i> Add</button>
                        </div>
                        @foreach (var choice in prop.Choices)
                        {
                            <div class="input-group mb-1">
                                <input class="form-input rounded-r-none" placeholder="Label" @bind="choice.Label" @bind:after="State.MarkDirty" />
                                <input class="form-input rounded-none border-l-0" placeholder="Value"
                                       value="@choice.Value?.ToString()"
                                       @onchange="e => { choice.Value = e.Value?.ToString(); State.MarkDirty(); }" />
                                <button type="button" class="btn btn-danger-secondary btn-sm btn-appended"
                                        title="@Localizer["Common.Remove"]" aria-label="@Localizer["Common.Remove"]"
                                        @onclick="() => RemoveChoice(prop, choice)">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    </div>
                }

                <button class="btn btn-secondary btn-sm disabled:opacity-50"
                        @onclick="() => SetTitleProperty(prop)"
                        disabled="@(State.Definition.TitleProperty == prop.Key)">
                    <i class="bi bi-star"></i> @Localizer["DomainObjectDesigner.SetTitleProperty"]
                </button>
            }
            else
            {
                <div class="text-ink-muted text-sm">@Localizer["DomainObjectDesigner.SelectProperty"]</div>
            }
            </div>  @* close tab content *@
        </div>  @* close sidebar wrapper *@
    </div>
</div>

@code {
    [Parameter] public Guid? ObjectId { get; set; }

    private bool _isBusy;
    private string? _error;
    private string _sidebarTab = "props";

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        await State.EnsureCatalogAsync();
        if (ObjectId.HasValue)
            await State.LoadAsync(ObjectId.Value);
    }

    public void Dispose() => State.OnChange -= StateHasChanged;

    private async Task HandleSave()
    {
        _isBusy = true; _error = null;
        try
        {
            var wasNew = State.IsNew;
            await State.SaveAsync();
            if (wasNew && State.StoredObjectId.HasValue)
                Navigation.NavigateTo($"/DomainObjects/Edit/{State.StoredObjectId}", forceLoad: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isBusy = false; }
    }

    private async Task HandlePublish()
    {
        _isBusy = true; _error = null;
        try
        {
            var wasNew = State.IsNew;
            await State.PublishAsync();
            if (wasNew && State.StoredObjectId.HasValue)
                Navigation.NavigateTo($"/DomainObjects/Edit/{State.StoredObjectId}", forceLoad: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isBusy = false; }
    }

    private void AddChoice(DomainProperty prop) { prop.Choices.Add(new DomainChoiceOption()); State.MarkDirty(); }
    private void RemoveChoice(DomainProperty prop, DomainChoiceOption choice) { prop.Choices.Remove(choice); State.MarkDirty(); }
    private void SetTitleProperty(DomainProperty prop) { State.Definition.TitleProperty = prop.Key; State.MarkDirty(); }
}
