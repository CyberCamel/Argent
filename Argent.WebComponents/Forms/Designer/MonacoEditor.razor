@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_containerId" style="width: 100%; height: @Height;"></div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Language { get; set; } = "javascript";
    [Parameter] public string Height { get; set; } = "200px";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool EnablePlatformApi { get; set; }

    private string _containerId = "monaco-" + Guid.NewGuid().ToString("N");
    private DotNetObjectReference<MonacoEditor>? _dotNetRef;
    private bool _initialized;
    private string? _lastValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ArgentMonaco.init", _containerId, Value ?? "", Language, _dotNetRef, ReadOnly, Placeholder, EnablePlatformApi);
            _lastValue = Value ?? string.Empty;
            _initialized = true;
            await JS.InvokeVoidAsync("ArgentMonaco.setValue", _containerId, _lastValue);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || string.Equals(_lastValue, Value ?? string.Empty, StringComparison.Ordinal))
            return;

        _lastValue = Value ?? string.Empty;
        await JS.InvokeVoidAsync("ArgentMonaco.setValue", _containerId, _lastValue);
    }

    public async Task SetValue(string value)
    {
        if (_initialized)
        {
            _lastValue = value;
            await JS.InvokeVoidAsync("ArgentMonaco.setValue", _containerId, value);
        }
    }

    [JSInvokable]
    public async Task OnValueChanged(string value)
    {
        _lastValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        if (_initialized)
        {
            try
            {
                await JS.InvokeVoidAsync("ArgentMonaco.dispose", _containerId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }
}
