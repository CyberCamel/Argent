@using Argent.Core.Authorization
@inject IGroupService GroupService
@inject Microsoft.AspNetCore.Components.NavigationManager NavManager
@inject IStringLocalizer<SharedResource> Localizer

<div class="bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700">
    <div class="p-4">
        <h5 class="font-bold mb-3">@(GroupId == null ? Localizer["GroupEditor.TitleNew"] : Localizer["GroupEditor.TitleEdit"])</h5>

        @if (_isSystem)
        {
            <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-3 text-sm text-yellow-800 dark:text-yellow-200 flex items-center gap-2">
                <i class="bi bi-shield-lock-fill"></i>
                <span>@Localizer["GroupEditor.SystemGroupMessage"]</span>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-3 text-sm text-red-800 dark:text-red-200">@_error</div>
            }

            <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">@Localizer["Common.Name"]</label>
                <input type="text" class="form-input" @bind="Name" placeholder="@Localizer["GroupEditor.NamePlaceholder"]" />
            </div>

            <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">@Localizer["Common.Description"]</label>
                <textarea class="form-input" @bind="Description" rows="2"></textarea>
            </div>

            <MemberSelector Label="@Localizer["GroupEditor.Members"]" EmptyText="@Localizer["GroupEditor.NoMembers"]"
                            Options="_userOptions" Selected="_selectedUsers"
                            Searchable="true" ItemUrl="@UserViewUrl" />

            <MemberSelector Label="@Localizer["GroupEditor.MemberGroups"]" EmptyText="@Localizer["GroupEditor.NoNestedGroups"]"
                            Options="_groupOptions" Selected="_selectedGroups" />

            <div class="flex gap-2">
                <button class="px-3 py-1.5 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" @onclick="Save" disabled="@_saving">
                    @(_saving ? Localizer["GroupEditor.Saving"] : Localizer["GroupEditor.SaveGroup"])
                </button>
                <a class="px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors" href="/Admin/Groups">@Localizer["Common.Cancel"]</a>
            </div>
        }

        @if (_isSystem)
        {
            <a class="px-3 py-1.5 text-sm font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 rounded-lg transition-colors" href="/Admin/Groups">@Localizer["Common.Back"]</a>
        }
    </div>
</div>

@code {
    [Parameter] public Guid? GroupId { get; set; }

    private string Name = "";
    private string? Description;
    private bool _saving;
    private bool _isSystem;
    private string? _error;

    private List<MemberSelector.MemberOption> _userOptions = [];
    private List<MemberSelector.MemberOption> _groupOptions = [];
    private readonly HashSet<string> _selectedUsers = [];
    private readonly HashSet<string> _selectedGroups = [];

    protected override async Task OnInitializedAsync()
    {
        var users = await GroupService.GetUsersAsync();
        _userOptions = users.Select(u => new MemberSelector.MemberOption(u.Id, u.Label, u.Icon)).ToList();

        var groups = await GroupService.GetGroupsAsync(GroupId);
        _groupOptions = groups.Select(g => new MemberSelector.MemberOption(g.Id, g.Label, g.Icon)).ToList();

        if (GroupId != null)
        {
            var detail = await GroupService.GetAsync(GroupId.Value);
            if (detail != null)
            {
                Name = detail.Name;
                Description = detail.Description;
                _isSystem = detail.IsSystem;
                foreach (var uid in detail.UserMemberIds) _selectedUsers.Add(uid.ToString());
                foreach (var gid in detail.GroupMemberIds) _selectedGroups.Add(gid.ToString());
            }
        }
    }

    private static string? UserViewUrl(string id) => "/Users/View/" + id;

    private async Task Save()
    {
        if (_isSystem) return;

        _saving = true;
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                _error = Localizer["GroupEditor.NameRequired"];
                return;
            }

            var userGuids  = _selectedUsers .Select(id => Guid.TryParse(id, out var g) ? g : (Guid?)null).Where(g => g.HasValue).Select(g => g!.Value).ToList();
            var groupGuids = _selectedGroups.Select(id => Guid.TryParse(id, out var g) ? g : (Guid?)null).Where(g => g.HasValue).Select(g => g!.Value).ToList();

            if (GroupId == null)
                await GroupService.CreateAsync(Name, Description, userGuids, groupGuids);
            else
                await GroupService.UpdateAsync(GroupId.Value, Name, Description, userGuids, groupGuids);

            NavManager.NavigateTo("/Admin/Groups");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
