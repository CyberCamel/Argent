@page
@model PrivacyModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Privacy.PageTitle"];
}

<div class="card">
    <div class="p-5">
        <h1 class="text-lg font-bold text-ink-heading mb-3">@ViewData["Title"]</h1>
        <p class="text-sm text-ink-muted mb-0">@Localizer["Privacy.Description"]</p>
    </div>
</div>
