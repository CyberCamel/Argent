@page
@model PrivacyModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Privacy.PageTitle"];
}

<div class="card">
    <div class="p-5">
        <h1 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-3">@ViewData["Title"]</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-0">@Localizer["Privacy.Description"]</p>
    </div>
</div>
