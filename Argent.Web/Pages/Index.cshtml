@page
@model IndexModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Index.PageTitle"];
}

<partial name="~/Pages/Shared/_PageHeader.cshtml" model='new Argent.Web.Pages.Shared.PageHeaderModel {
    Title = Localizer["Index.Heading"],
    Subtitle = Localizer["Index.Subtitle"]
}' />

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <section class="card flex flex-col">
        <div class="card-header">
            <div class="flex items-center gap-2.5 min-w-0">
                <i class="bi bi-diagram-3 text-ink-muted" aria-hidden="true"></i>
                <h2 class="card-title truncate">@Localizer["Index.SectionWorkflows"]</h2>
            </div>
            @if (Model.WorkflowCount > 0)
            {
                <span class="badge badge-neutral">@Model.WorkflowCount</span>
            }
        </div>
        <div class="flex-1">
            @if (Model.RecentWorkflows.Count == 0)
            {
                <p class="m-0 p-5 text-muted" style="font-size:var(--font-size-sm)">@Localizer["Index.NoWorkflows"]</p>
            }
            else
            {
                <ul class="m-0 p-0 list-none">
                    @foreach (var wf in Model.RecentWorkflows)
                    {
                        <li class="flex items-center justify-between gap-4 px-5 py-2.5 border-b border-line-subtle last:border-0">
                            <a href="/Workflows/View/@wf.Id" class="link-quiet truncate">@wf.Name</a>
                            @if (!string.IsNullOrEmpty(wf.Description))
                            {
                                <span class="text-muted truncate" style="font-size:var(--font-size-sm); max-width:50%">@wf.Description</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="card-footer">
                <a href="/Workflows" class="btn btn-secondary btn-sm">
                    @Localizer["Index.ViewAll"] <i class="bi bi-arrow-right" style="font-size:.75rem" aria-hidden="true"></i>
                </a>
            </div>
        }
    </section>

    <section class="card flex flex-col">
        <div class="card-header">
            <div class="flex items-center gap-2.5 min-w-0">
                <i class="bi bi-ui-checks text-ink-muted" aria-hidden="true"></i>
                <h2 class="card-title truncate">@Localizer["Index.SectionForms"]</h2>
            </div>
            @if (Model.FormCount > 0)
            {
                <span class="badge badge-neutral">@Model.FormCount</span>
            }
        </div>
        <div class="flex-1">
            @if (Model.RecentForms.Count == 0)
            {
                <p class="m-0 p-5 text-muted" style="font-size:var(--font-size-sm)">@Localizer["Index.NoForms"]</p>
            }
            else
            {
                <ul class="m-0 p-0 list-none">
                    @foreach (var form in Model.RecentForms)
                    {
                        <li class="flex items-center justify-between gap-4 px-5 py-2.5 border-b border-line-subtle last:border-0">
                            <div class="flex items-baseline gap-2 min-w-0">
                                <a href="/Forms/Live/@form.Id" class="link-quiet truncate">@form.Name</a>
                                @if (!string.IsNullOrEmpty(form.Description))
                                {
                                    <span class="text-muted truncate" style="font-size:var(--font-size-sm)">@form.Description</span>
                                }
                            </div>
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <a href="/Forms/Edit/@form.Id" class="btn btn-action" title="@Localizer["Common.Edit"]" aria-label="@Localizer["Common.Edit"]">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="card-footer">
                <a href="/Forms" class="btn btn-secondary btn-sm">
                    @Localizer["Index.ViewAll"] <i class="bi bi-arrow-right" style="font-size:.75rem" aria-hidden="true"></i>
                </a>
            </div>
        }
    </section>
</div>

@if (!(User.Identity?.IsAuthenticated ?? false))
{
    <div class="empty-state">
        <div style="max-width:26rem">
            <i class="bi bi-shield-lock" style="font-size:2rem; color: var(--fg-muted); opacity:.7" aria-hidden="true"></i>
            <p class="m-0" style="font-size:var(--font-size-md); font-weight:500; color:var(--fg)">@Localizer["Index.SignInPrompt"]</p>
        </div>
    </div>
}
