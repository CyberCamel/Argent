@using Argent.Web.Pages.Shared
@model PageHeaderModel
<header class="page-header">
    <div class="page-header-main">
        @if (!string.IsNullOrEmpty(Model.Kicker))
        {
            <span class="page-header-kicker">@Model.Kicker</span>
        }
        <h1 class="page-header-title">@Model.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="page-header-subtitle">@Model.Subtitle</p>
        }
    </div>
    @{
        var hasActions = Model.ActionLink != null || Model.ActionModal != null;
    }
    @if (hasActions)
    {
        <div class="page-header-actions">
            @if (Model.ActionLink != null)
            {
                <a href="@Model.ActionLink.Url" class="btn btn-primary">
                    @if (!string.IsNullOrEmpty(Model.ActionLink.Icon))
                    {
                        <i class="@Model.ActionLink.Icon" aria-hidden="true"></i>
                    }
                    @Model.ActionLink.Label
                </a>
            }
            @if (Model.ActionModal != null)
            {
                <button type="button" class="btn btn-primary"
                        @@click="window.dispatchEvent(new CustomEvent('open-modal', {detail: '@Model.ActionModal.ModalId'}))">
                    @if (!string.IsNullOrEmpty(Model.ActionModal.Icon))
                    {
                        <i class="@Model.ActionModal.Icon" aria-hidden="true"></i>
                    }
                    @Model.ActionModal.Label
                </button>
            }
        </div>
    }
</header>
