@model Argent.Web.Pages.Shared.EmptyStateModel
@inject IStringLocalizer<SharedResource> Localizer
<div class="empty-state">
    <div style="max-width:26rem">
        @if (!string.IsNullOrEmpty(Model.Icon))
        {
            <i class="@Model.Icon" style="font-size:2rem; color: var(--fg-muted); opacity:.7" aria-hidden="true"></i>
        }
        <p class="m-0" style="font-size:var(--font-size-md); font-weight:500; color:var(--fg)">@Model.Message</p>
        @if (!string.IsNullOrEmpty(Model.Hint))
        {
            <p class="mt-1.5 mb-0 text-muted" style="font-size:var(--font-size-sm)">@Model.Hint</p>
        }
        @if (!string.IsNullOrEmpty(Model.LinkText) && !string.IsNullOrEmpty(Model.LinkUrl))
        {
            <a href="@Model.LinkUrl" class="btn btn-primary" style="margin-top:1.25rem">@Model.LinkText</a>
        }
    </div>
</div>
