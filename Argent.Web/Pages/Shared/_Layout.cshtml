@using Argent.Core.Branding
@using Microsoft.Extensions.Localization
@inject IBrandingService BrandingService
@inject IStringLocalizer<SharedResource> Localizer
@{
    var branding = await BrandingService.GetAsync();
    var siteName = branding?.SiteName ?? "Argent";
    var logoUrl = branding?.LogoUrl;
    var faviconUrl = branding?.FaviconUrl;
    var primaryColor = (branding?.IsEnabled ?? true) ? (branding?.PrimaryColor ?? "#4f46e5") : "#4f46e5";
    var primaryHoverColor = (branding?.IsEnabled ?? true) ? (branding?.PrimaryHoverColor ?? "#4338ca") : "#4338ca";
    var footerText = branding?.FooterText;
    var customCss = (branding?.IsEnabled ?? true) ? branding?.CustomCss : null;

    var currentPath = Context.Request.Path.Value ?? "/";

    // "/Admin/Groups" must not light up for "/Admin/Groups/Edit/{id}", but
    // "/Admin/Groups/Edit/..." should light up for the Groups section.
    string NavActive(string page)
    {
        var exact = page == "/"
            ? currentPath == "/"
            : string.Equals(currentPath, page, StringComparison.OrdinalIgnoreCase);
        var nested = page != "/" && currentPath.StartsWith(page + "/", StringComparison.OrdinalIgnoreCase);
        return exact || nested ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" x-data="theme()" x-init="init" :class="dark ? 'dark' : ''">
<head>
    <base href="/" />
    <component type="typeof(Microsoft.AspNetCore.Components.Web.HeadOutlet)" render-mode="ServerPrerendered" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modeler.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/designer.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(faviconUrl))
    {
        <link rel="icon" type="image/x-icon" href="@faviconUrl">
    }
    @await RenderSectionAsync("Styles", required: false)
    <style>
        [x-cloak] { display: none !important; }
        :root { --primary: @primaryColor; --primary-hover: @primaryHoverColor; }
        @if (!string.IsNullOrEmpty(customCss))
        {
            @Html.Raw((string)customCss)
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-surface focus:px-3 focus:py-2 focus:text-sm focus:shadow-md">@Localizer["Nav.SkipToContent"]</a>

    @* x-data lives on the header, not the inner bar: the mobile panel is a sibling of
       <nav> rather than a descendant, so a scope on <nav> would leave mobileOpen
       unresolvable there. Alpine walks up the tree, so theme() above still applies. *@
    <header class="app-header" x-data="{ mobileOpen: false }">
        <nav class="app-header-inner" aria-label="@Localizer["Nav.Primary"]">
            <a asp-page="/Index" class="app-brand">
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <img src="@logoUrl" alt="" />
                }
                else
                {
                    <i class="bi bi-diamond-fill" style="color: @primaryColor" aria-hidden="true"></i>
                }
                <span>@siteName</span>
            </a>

            <div class="app-nav">
                <a asp-page="/Index" class="nav-link @NavActive("/")">@Localizer["Nav.Home"]</a>
                <a asp-page="/Tasks/Index" class="nav-link @NavActive("/Tasks")">@Localizer["Nav.MyTasks"]</a>
                <a asp-page="/Workflows/Index" class="nav-link @NavActive("/Workflows")">@Localizer["Nav.Workflows"]</a>
                <a asp-page="/Forms/Index" class="nav-link @NavActive("/Forms")">@Localizer["Nav.Forms"]</a>
                <a asp-page="/DomainObjects/Index" class="nav-link @NavActive("/DomainObjects")">@Localizer["Nav.DomainObjects"]</a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <div class="relative" x-data="{ open: false }" @@click.outside="open = false">
                        <button type="button" @@click="open = !open" :aria-expanded="open" class="nav-link">
                            @Localizer["Nav.Admin"] <i class="bi bi-chevron-down" style="font-size:.7rem" aria-hidden="true"></i>
                        </button>
                        <div x-show="open" x-cloak class="nav-menu left-0">
                            <span class="nav-menu-label">@Localizer["Nav.Admin"]</span>
                            <a asp-page="/DataSources/Index" class="nav-dropdown-item">
                                <i class="bi bi-hdd-network" aria-hidden="true"></i>@Localizer["Nav.DataSources"]
                            </a>
                            <a asp-page="/Admin/WorkflowInstances/Index" class="nav-dropdown-item">
                                <i class="bi bi-diagram-3" aria-hidden="true"></i>@Localizer["Nav.Instances"]
                            </a>
                            <a asp-page="/Admin/Workers/Index" class="nav-dropdown-item">
                                <i class="bi bi-cpu" aria-hidden="true"></i>@Localizer["Nav.Workers"]
                            </a>
                            <a asp-page="/Admin/WorkerRequests/Index" class="nav-dropdown-item">
                                <i class="bi bi-inbox" aria-hidden="true"></i>@Localizer["Nav.WorkerRequests"]
                            </a>
                            <a asp-page="/Admin/Audit/Index" class="nav-dropdown-item">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>@Localizer["Nav.Audit"]
                            </a>
                            <a asp-page="/Admin/Capabilities" class="nav-dropdown-item">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>@Localizer["Nav.Capabilities"]
                            </a>
                            <a asp-page="/Admin/Groups/Index" class="nav-dropdown-item">
                                <i class="bi bi-people" aria-hidden="true"></i>@Localizer["Nav.Groups"]
                            </a>
                            <a asp-page="/Admin/Branding" class="nav-dropdown-item">
                                <i class="bi bi-palette" aria-hidden="true"></i>@Localizer["Nav.Branding"]
                            </a>
                        </div>
                    </div>
                }
            </div>

            <div class="app-header-tools">
                <button type="button" @@click="toggle()" class="nav-icon-btn" title="@Localizer["Nav.ToggleDarkMode"]" aria-label="@Localizer["Nav.ToggleDarkMode"]">
                    <template x-if="!dark">
                        <i class="bi bi-moon-stars" aria-hidden="true"></i>
                    </template>
                    <template x-if="dark">
                        <i class="bi bi-sun" aria-hidden="true"></i>
                    </template>
                </button>
                @{
                    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                    var alternateCulture = currentCulture == "sv" ? "en" : "sv";
                    var alternateLabel = currentCulture == "sv" ? "EN" : "SV";
                }
                <a href="/SetCulture?culture=@alternateCulture&returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"
                   class="nav-icon-btn"
                   style="font-size:.6875rem; font-weight:600; letter-spacing:.06em"
                   title="@Localizer["Nav.ToggleLanguage"]"
                   aria-label="@Localizer["Nav.ToggleLanguage"]"
                   hreflang="@alternateCulture">@alternateLabel</a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <div class="relative" x-data="{ open: false }" @@click.outside="open = false">
                        <button type="button" @@click="open = !open" :aria-expanded="open" class="nav-user-btn">
                            <span class="avatar avatar-sm" aria-hidden="true">@((User.FindFirst("FirstName")?.Value ?? User.Identity.Name)?[0])</span>
                            <span class="hidden sm:inline">@(User.FindFirst("FirstName")?.Value ?? User.Identity.Name)</span>
                            <i class="bi bi-chevron-down" style="font-size:.7rem" aria-hidden="true"></i>
                        </button>
                        <div x-show="open" x-cloak class="nav-menu right-0">
                            <a asp-page="/Profile" class="nav-dropdown-item">
                                <i class="bi bi-person" aria-hidden="true"></i>@Localizer["Nav.MyProfile"]
                            </a>
                            <hr class="nav-menu-sep" />
                            <form asp-page="/Account/Logout" method="post">
                                <button type="submit" class="nav-dropdown-item is-danger">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>@Localizer["Nav.Logout"]
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-page="/Login" class="nav-link">@Localizer["Nav.Login"]</a>
                }
                <button type="button" @@click="mobileOpen = !mobileOpen" :aria-expanded="mobileOpen"
                        class="nav-icon-btn md:hidden" aria-label="@Localizer["Nav.ToggleNavigation"]" aria-controls="mobile-nav">
                    <i class="bi bi-list" style="font-size:1.25rem" aria-hidden="true"></i>
                </button>
            </div>
        </nav>

        <div id="mobile-nav" x-show="mobileOpen" x-cloak class="md:hidden" style="border-top:1px solid var(--shell-border)">
            <div class="mx-auto w-full flex flex-col gap-0.5" style="max-width:80rem; padding:.75rem 1rem 1rem">
                <a asp-page="/Index" class="nav-link-mobile @NavActive("/")">@Localizer["Nav.Home"]</a>
                <a asp-page="/Tasks/Index" class="nav-link-mobile @NavActive("/Tasks")">@Localizer["Nav.MyTasks"]</a>
                <a asp-page="/Workflows/Index" class="nav-link-mobile @NavActive("/Workflows")">@Localizer["Nav.Workflows"]</a>
                <a asp-page="/Forms/Index" class="nav-link-mobile @NavActive("/Forms")">@Localizer["Nav.Forms"]</a>
                <a asp-page="/DomainObjects/Index" class="nav-link-mobile @NavActive("/DomainObjects")">@Localizer["Nav.DomainObjects"]</a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <span class="nav-menu-label" style="padding-top:.75rem">@Localizer["Nav.Admin"]</span>
                    <a asp-page="/DataSources/Index" class="nav-link-mobile">@Localizer["Nav.DataSources"]</a>
                    <a asp-page="/Admin/WorkflowInstances/Index" class="nav-link-mobile">@Localizer["Nav.Instances"]</a>
                    <a asp-page="/Admin/Workers/Index" class="nav-link-mobile">@Localizer["Nav.Workers"]</a>
                    <a asp-page="/Admin/WorkerRequests/Index" class="nav-link-mobile">@Localizer["Nav.WorkerRequests"]</a>
                    <a asp-page="/Admin/Audit/Index" class="nav-link-mobile">@Localizer["Nav.Audit"]</a>
                    <a asp-page="/Admin/Capabilities" class="nav-link-mobile">@Localizer["Nav.Capabilities"]</a>
                    <a asp-page="/Admin/Groups/Index" class="nav-link-mobile">@Localizer["Nav.Groups"]</a>
                    <a asp-page="/Admin/Branding" class="nav-link-mobile">@Localizer["Nav.Branding"]</a>
                }
            </div>
        </div>
    </header>

    @if (ViewData["IsFullWidth"] is bool fullWidth && fullWidth == true)
    {
        @* No min-h-0 here on purpose. This wrapper is the flex item that gives the
           full-bleed designers (workflow modeler, form designer) a non-zero height to
           resolve `height: 100%` against. Its automatic minimum size is what stops the
           collapse propagating up from .modeler-canvas / .modeler-canvas-col, which set
           min-height: 0 internally. Adding min-h-0 here collapses the canvas to zero,
           which breaks canvas hit-testing and the screen-to-world conversion. *@
        <div class="w-full flex-1 flex flex-col" id="main-content">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="w-full flex-1 flex flex-col" id="main-content">
            <div class="mx-auto w-full flex-1" style="max-width:80rem; padding:1.5rem 1rem 2.5rem">
                <main class="app-page">
                    @RenderBody()
                </main>
            </div>
        </div>
    }

    <footer class="app-footer">
        <div class="app-footer-inner">
            <p class="app-footer-text">@(string.IsNullOrEmpty(footerText) ? $"© {DateTime.Now.Year} {siteName}" : footerText)</p>
            <a asp-area="" asp-page="/Privacy" class="app-footer-link">@Localizer["Nav.Privacy"]</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/monaco.js" asp-append-version="true"></script>
    <script src="~/js/modeler.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/argent-form.js" asp-append-version="true"></script>
    <script src="~/lib/htmx.min.js" asp-append-version="true"></script>
    <script src="~/lib/alpine/alpine.min.js" defer></script>
    <script>
        function theme() {
            return {
                dark: false,
                init() {
                    const stored = localStorage.getItem('argent-theme');
                    if (stored) {
                        this.dark = stored === 'dark';
                    } else {
                        this.dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    }
                },
                toggle() {
                    this.dark = !this.dark;
                    localStorage.setItem('argent-theme', this.dark ? 'dark' : 'light');
                }
            }
        }

        window.ArgentCulture = {
            get: () => {
                const match = document.cookie.match(/(?:^|;\s*)\.AspNetCore\.Culture=([^;]*)/);
                return match ? decodeURIComponent(match[1]) : null;
            }
        };
    </script>
    @* ArgentCulture must exist before the WASM host starts and reads it. *@
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
