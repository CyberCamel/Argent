@page
@model ErrorModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Error.PageTitle"];
}

<div class="text-center py-12">
    <i class="bi bi-exclamation-triangle text-4xl text-danger mb-3 block"></i>
    <h1 class="text-lg font-bold text-danger">@Localizer["Error.Heading"]</h1>
    <p class="text-sm text-ink-muted mb-0">@Localizer["Error.Message"]</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 mb-0 text-sm text-gray-400">
            @Localizer["Error.RequestId"] <code class="bg-sunken px-1.5 py-0.5 rounded text-xs">@Model.RequestId</code>
        </p>
    }
</div>
