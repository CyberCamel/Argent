@page "/Users"
@model IndexModel
@{
    ViewData["Title"] = Localizer["Admin.Users.Index.PageTitle"];
}

<partial name="~/Pages/Shared/_PageHeader.cshtml" model='new Argent.Web.Pages.Shared.PageHeaderModel {
    Title = Localizer["Admin.Users.Index.PageTitle"].Value,
    Subtitle = Localizer["Admin.Users.Index.Subtitle"].Value,
    ActionModal = new Argent.Web.Pages.Shared.ModalModel(Localizer["Admin.Users.Index.AddUser"].Value, "userModalContent", "bi-plus-lg")
}' />

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>@Localizer["Common.Name"]</th>
                <th>@Localizer["Users.View.EmailLabel"]</th>
                <th>@Localizer["Users.View.RolesLabel"]</th>
                <th class="text-right">@Localizer["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody id="userTable"
               hx-get="/UserAdministration/List"
               hx-trigger="load, userActionCompleted from:body, userDeleted from:body"
               hx-swap="innerHTML">
            <partial name="~/Pages/Admin/Users/_UserTablePartial.cshtml" model="Model.Users" />
        </tbody>
    </table>
</div>

@* User modal (Alpine-based) *@
<div id="userModal" class="dialog-backdrop"
     x-data="{ open: false }"
     x-init="open = false"
     x-show="open"
     x-cloak
     @@open-modal.window="if ($event.detail === 'userModalContent') open = true"
     @@keydown.escape.window="open = false">
    <div class="dialog dialog-lg" role="dialog" aria-modal="true" aria-labelledby="userModalTitle" @@click.outside="open = false">
        <div class="dialog-header">
            <h2 class="dialog-title" id="userModalTitle">@Localizer["Admin.Users.Index.ModalTitle"]</h2>
            <button type="button" class="dialog-close" @@click="open = false" aria-label="@Localizer["Common.Close"]">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="dialog-body" id="modalBody">
            <div class="text-center py-4 text-muted" style="font-size:var(--font-size-sm)">@Localizer["Admin.Users.Index.Loading"]</div>
        </div>
    </div>
</div>

<script>
    document.body.addEventListener('htmx:afterSwap', function (e) {
        if (e.target.id === "modalBody") {
            // Open the Alpine modal
            Alpine.$data(document.getElementById('userModal')).open = true;
        }
    });

    document.body.addEventListener('userActionCompleted', function () {
        Alpine.$data(document.getElementById('userModal')).open = false;
    });
</script>
