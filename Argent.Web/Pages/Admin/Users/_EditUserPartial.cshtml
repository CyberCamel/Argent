@using Argent.Web.Models.ViewModels
@model EditUserViewModel

<form hx-post="/UserAdministration/Edit"
      hx-target="#modalBody"
      hx-swap="innerHTML">
    <div asp-validation-summary="ModelOnly" class="text-sm text-danger mb-3"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
        <div>
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-input" />
            <span asp-validation-for="FirstName" class="text-xs text-red-500"></span>
        </div>
        <div>
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-input" />
            <span asp-validation-for="LastName" class="text-xs text-red-500"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-input" />
        <span asp-validation-for="UserName" class="text-xs text-red-500"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-input" />
        <span asp-validation-for="Email" class="text-xs text-red-500"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Users.View.RolesLabel"]</label>
        <div class="flex flex-wrap gap-2 p-3 bg-sunken rounded-lg border border-line">
            @foreach (var role in Model.AvailableRoles)
            {
                <label class="flex items-center gap-1.5 text-sm text-ink cursor-pointer">
                    <input type="checkbox" name="Roles" value="@role"
                           @(Model.Roles.Contains(role) ? "checked" : "")
                           class="rounded border-line-strong text-indigo-600 focus:ring-indigo-500" />
                    @role
                </label>
            }
        </div>
    </div>

    <div class="text-right mt-4">
        <button type="submit" class="btn btn-primary">@Localizer["Admin.Users.EditPartial.SaveButton"]</button>
    </div>
</form>
