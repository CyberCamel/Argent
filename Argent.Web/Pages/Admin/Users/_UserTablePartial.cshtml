@using Argent.Web.Models.ViewModels
@model IEnumerable<UserViewModel>

@foreach (var user in Model)
{
    <tr>
        <td>
            <a href="/Users/View/@user.Id" class="font-medium text-accent-text hover:underline">
                @user.FirstName @user.LastName
            </a>
        </td>
        <td class="text-ink-muted">@user.Email</td>
        <td>
            <div class="flex flex-wrap gap-1">
                @foreach (var role in user.Roles)
                {
                    <span class="badge badge-neutral">@role</span>
                }
            </div>
        </td>
        <td class="text-right">
            <div class="flex items-center justify-end gap-1">
                <a class="btn-action btn-action-primary" href="/Users/View/@user.Id" title="@Localizer["Common.View"]">
                    <i class="bi bi-eye-fill"></i>
                </a>
                <button class="btn-action btn-action-secondary" title="@Localizer["Common.Edit"]"
                        hx-get="/UserAdministration/Edit/@user.UserName"
                        hx-target="#modalBody"
                        hx-trigger="click"
                        hx-on="htmx:afterSwap: Alpine.$data(document.getElementById('userModal')).open = true">
                    <i class="bi bi-pencil-fill"></i>
                </button>
                <form hx-post="/UserAdministration/Delete/@user.UserName" method="post"
                      class="inline"
                      hx-confirm="@Localizer["Admin.Users.TablePartial.DeleteConfirm"]"
                      hx-target="closest tr"
                      hx-swap="outerHTML">
                    <button type="submit" class="btn-action btn-action-danger" title="@Localizer["Common.Delete"]">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </form>
            </div>
        </td>
    </tr>
}
