@page "/Admin/WorkerRequests"
@model Argent.Web.Pages.Admin.WorkerRequests.IndexModel
@using Argent.Core.Workers
@{
    ViewData["Title"] = Localizer["Admin.WorkerRequests.Index.PageTitle"];

    string StateBadge(WorkerRequestState state) => state switch
    {
        WorkerRequestState.Pending   => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400 border-gray-200 dark:border-gray-700",
        WorkerRequestState.Claimed   => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 border-blue-200 dark:border-blue-800",
        WorkerRequestState.Succeeded => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200 border-green-200 dark:border-green-800",
        WorkerRequestState.Failed    => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200 border-red-200 dark:border-red-800",
        WorkerRequestState.TimedOut  => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200 border-yellow-200 dark:border-yellow-800",
        WorkerRequestState.Cancelled => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400 border-gray-200 dark:border-gray-700",
        _                            => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400 border-gray-200 dark:border-gray-700"
    };
}

<partial name="~/Pages/Shared/_PageHeader.cshtml" model='new Argent.Web.Pages.Shared.PageHeaderModel {
    Title = Localizer["Admin.WorkerRequests.Index.PageTitle"].Value,
    Subtitle = Localizer["Admin.WorkerRequests.Index.Subtitle"].Value
}' />

<form method="get" class="flex flex-wrap items-end gap-3 mb-4">
    <div>
        <label class="block text-xs text-ink-muted mb-1" for="workerName">@Localizer["Admin.WorkerRequests.Index.FilterWorker"]</label>
        <select id="workerName" name="workerName" class="input-field">
            <option value="">@Localizer["Admin.WorkerRequests.Index.FilterAll"]</option>
            @foreach (var name in Model.Workers)
            {
                <option value="@name" selected="@(Model.FilterWorkerName == name)">@name</option>
            }
        </select>
    </div>
    <div>
        <label class="block text-xs text-ink-muted mb-1" for="state">@Localizer["Common.State"]</label>
        <select id="state" name="state" class="input-field">
            <option value="">@Localizer["Admin.WorkerRequests.Index.FilterAll"]</option>
            @foreach (WorkerRequestState state in Enum.GetValues<WorkerRequestState>())
            {
                <option value="@state" selected="@(Model.FilterState == state)">@state</option>
            }
        </select>
    </div>
    <button type="submit" class="btn-action btn-action-primary">@Localizer["Admin.WorkerRequests.Index.FilterApply"]</button>
</form>

@if (Model.Requests.Count == 0)
{
    <partial name="~/Pages/Shared/_EmptyState.cshtml" model='new Argent.Web.Pages.Shared.EmptyStateModel {
        Icon = "bi-inbox",
        Message = Localizer["Admin.WorkerRequests.Index.EmptyMessage"].Value
    }' />
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@Localizer["Admin.WorkerRequests.Index.TableWorker"]</th>
                    <th>@Localizer["Admin.WorkerRequests.Index.TableSubject"]</th>
                    <th>@Localizer["Common.State"]</th>
                    <th>@Localizer["Admin.WorkerRequests.Index.TableInstance"]</th>
                    <th>@Localizer["Admin.WorkerRequests.Index.TableAttempts"]</th>
                    <th>@Localizer["Admin.WorkerRequests.Index.TableCreated"]</th>
                    <th class="text-right">@Localizer["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td class="font-medium">@request.WorkerName</td>
                        <td class="font-mono text-xs">@request.Subject</td>
                        <td>
                            <span class="badge @StateBadge(request.State)">@request.State</span>
                            @if (request.IsOverdue)
                            {
                                <div class="text-xs text-warning mt-1">
                                    <i class="bi bi-hourglass-split"></i>
                                    @string.Format(Localizer["Admin.WorkerRequests.Index.OverdueHint"].Value, request.TimeoutSeconds)
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(request.ErrorMessage))
                            {
                                <div class="text-xs text-ink-muted mt-1 max-w-xs truncate" title="@request.ErrorMessage">@request.ErrorMessage</div>
                            }
                        </td>
                        <td>
                            <a asp-page="/Admin/WorkflowInstances/Detail" asp-route-id="@request.InstanceId"
                               class="text-accent-text hover:underline text-xs">
                                @(request.InstanceName ?? request.InstanceId.ToString())
                            </a>
                        </td>
                        <td class="text-sm">@request.Attempt <span class="text-gray-400">/ @request.MaxAttempts</span></td>
                        <td class="text-xs text-ink-muted whitespace-nowrap">
                            @request.CreatedAt.ToString("g")
                            @if (request.LeaseExpiresAt is { } lease)
                            {
                                <div>@Localizer["Admin.WorkerRequests.Index.LeasePrefix"] @lease.ToString("t")</div>
                            }
                        </td>
                        <td class="text-right">
                            @if (request.State is WorkerRequestState.Pending or WorkerRequestState.Claimed)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@request.Id" class="inline">
                                    <button type="submit" class="btn-action btn-action-secondary"
                                            title="@Localizer["Admin.WorkerRequests.Index.CancelButton"]">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
