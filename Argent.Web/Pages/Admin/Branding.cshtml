@page "/Admin/Branding"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@model Argent.Web.Pages.Admin.BrandingModel
@{
    ViewData["Title"] = @Localizer["Branding.Title"];
}

<partial name="~/Pages/Shared/_PageHeader.cshtml" model='new Argent.Web.Pages.Shared.PageHeaderModel {
    Title = Localizer["Branding.Title"],
    Subtitle = Localizer["Branding.Subtitle"]
}' />

@if (Model.Saved)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle-fill alert-icon" aria-hidden="true"></i>
        <span>@Localizer["Branding.SavedMessage"]</span>
    </div>
}

<form method="post" class="flex flex-col gap-6" style="max-width:42rem">
    <section class="card">
        <div class="card-header">
            <h3 class="card-title">@Localizer["Branding.General"]</h3>
        </div>
        <div class="card-body flex flex-col gap-4">
            <div class="field">
                <label asp-for="SiteName" class="form-label">@Localizer["Branding.SiteName"]</label>
                <input asp-for="SiteName" class="form-input" />
                <span asp-validation-for="SiteName" class="form-error"></span>
            </div>

            <div class="field">
                <label asp-for="FooterText" class="form-label">@Localizer["Branding.FooterText"]</label>
                <input asp-for="FooterText" class="form-input" placeholder="&copy; @DateTime.Now.Year Argent" />
            </div>

            <label class="form-check">
                <input asp-for="IsEnabled" type="checkbox" />
                <span>@Localizer["Branding.EnableBranding"]</span>
            </label>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h3 class="card-title">@Localizer["Branding.LogoFavicon"]</h3>
        </div>
        <div class="card-body flex flex-col gap-4">
            <div class="field">
                <label asp-for="LogoUrl" class="form-label">@Localizer["Branding.LogoUrl"]</label>
                <input asp-for="LogoUrl" class="form-input" placeholder="https://example.com/logo.png" />
                <p class="form-hint">@Localizer["Branding.LogoUrlHint"]</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.LogoUrl))
            {
                <div class="flex items-center gap-3 p-3 bg-sunken border border-line-subtle rounded">
                    <span class="text-muted" style="font-size:var(--font-size-sm)">@Localizer["Branding.PreviewLabel"]:</span>
                    <img src="@Model.LogoUrl" alt="@Localizer["Branding.LogoPreview"]" style="height:2rem; width:auto" />
                </div>
            }

            <div class="field">
                <label asp-for="FaviconUrl" class="form-label">@Localizer["Branding.FaviconUrl"]</label>
                <input asp-for="FaviconUrl" class="form-input" placeholder="https://example.com/favicon.ico" />
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h3 class="card-title">@Localizer["Branding.Colors"]</h3>
        </div>
        <div class="card-body">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="field">
                    <label asp-for="PrimaryColor" class="form-label">@Localizer["Branding.PrimaryColor"]</label>
                    <div class="flex gap-2">
                        <input asp-for="PrimaryColor" type="color" class="form-input"
                               style="width:2.5rem; height:2.25rem; padding:.1875rem; cursor:pointer; flex-shrink:0" />
                        <input asp-for="PrimaryColor" class="form-input flex-1 font-mono" placeholder="#4f46e5" />
                    </div>
                </div>

                <div class="field">
                    <label asp-for="PrimaryHoverColor" class="form-label">@Localizer["Branding.PrimaryHoverColor"]</label>
                    <div class="flex gap-2">
                        <input asp-for="PrimaryHoverColor" type="color" class="form-input"
                               style="width:2.5rem; height:2.25rem; padding:.1875rem; cursor:pointer; flex-shrink:0" />
                        <input asp-for="PrimaryHoverColor" class="form-input flex-1 font-mono" placeholder="#4338ca" />
                    </div>
                </div>
            </div>

            <div class="mt-4 p-3 bg-sunken border border-line-subtle rounded flex flex-wrap items-center gap-3">
                <span class="text-muted" style="font-size:var(--font-size-sm)">@Localizer["Branding.PreviewLabel"]:</span>
                <span class="btn" style="pointer-events:none; background-color:@Model.PrimaryColor">@Localizer["Branding.PrimaryColor"]</span>
                <span class="btn" style="pointer-events:none; background-color:@Model.PrimaryHoverColor">@Localizer["Branding.PrimaryHoverColor"]</span>
            </div>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h3 class="card-title">@Localizer["Branding.CustomCss"]</h3>
        </div>
        <div class="card-body">
            <div class="field">
                <label asp-for="CustomCss" class="form-label">@Localizer["Branding.CustomCss"]</label>
                <textarea asp-for="CustomCss" class="form-textarea font-mono" rows="6"
                          placeholder="/* @Localizer["Branding.CustomCssHint"] */"></textarea>
                <p class="form-hint">@Localizer["Branding.CustomCssHint"]</p>
            </div>
        </div>
    </section>

    <div class="flex items-center gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg" aria-hidden="true"></i> @Localizer["Branding.SaveSettings"]
        </button>
        <a href="/Admin/Branding" class="btn btn-secondary">@Localizer["Branding.Reset"]</a>
    </div>
</form>
