@page "/Admin/Capabilities"
@using Argent.WebComponents.Authorization
@model Argent.Web.Pages.Admin.CapabilitiesModel
@{
    ViewData["Title"] = Localizer["Admin.Capabilities.Heading"];
}

<div class="flex items-start mb-4">
    <div>
        <h1 class="text-xl font-bold mb-1">@Localizer["Admin.Capabilities.Heading"]</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-0">
            @Localizer["Admin.Capabilities.Description"]
        </p>
    </div>
</div>

<component type="typeof(CapabilitiesPanel)" render-mode="ServerPrerendered" />
