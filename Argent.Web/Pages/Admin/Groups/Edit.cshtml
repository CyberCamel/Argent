@page "/Admin/Groups/Edit/{id:guid}"
@using Argent.WebComponents.Authorization
@model Argent.Web.Pages.Admin.Groups.EditModel
@{
    ViewData["Title"] = Localizer["Admin.Groups.Edit.PageTitle"];
}

<div class="mx-auto py-4" style="max-width: 720px;">
    <a href="/Admin/Groups" class="btn btn-secondary btn-sm mb-3">&larr; @Localizer["Admin.Groups.Edit.BackLink"]</a>
    <component type="typeof(GroupEditor)" render-mode="WebAssembly" param-GroupId="@Model.Id" />
</div>
