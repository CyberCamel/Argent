@page "/Tasks/Detail/{id:guid}"
@model Argent.Web.Pages.Tasks.DetailModel
@using Argent.Core.Workflows.Execution
@{
    ViewData["Title"] = Model.TaskItem.Title ?? Localizer["Tasks.Detail.PageTitle"].Value;
    var overdue = Model.TaskItem.DueDate.HasValue && Model.TaskItem.DueDate.Value < DateTime.UtcNow;
}

<div class="mx-auto" style="max-width: 56rem;">
    <a href="/Tasks" class="btn btn-ghost btn-sm mb-4">
        <i class="bi bi-arrow-left"></i> @Localizer["Tasks.Detail.BackToInbox"]
    </a>

    @if (TempData["TaskError"] is string taskError)
    {
        <div role="alert" class="alert alert-danger mb-4">@taskError</div>
    }

    <header class="card p-5 mb-4">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="min-w-0">
                <div class="flex flex-wrap gap-2 items-center mb-2">
                    <span class="badge badge-warning">@Model.TaskItem.State</span>
                    @if (Model.TaskItem.Priority != 0)
                    {
                        <span class="badge badge-warning">@Localizer["Tasks.Index.Priority", Model.TaskItem.Priority]</span>
                    }
                    <span class="badge @(Model.TaskItem.AssignedTo is null ? "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200" : "bg-indigo-100 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-200")">
                        @(Model.TaskItem.AssignedTo is null ? Localizer["Tasks.Detail.AvailableToClaim"] : Localizer["Tasks.Index.AssignedToYou"])
                    </span>
                </div>
                <h1 class="text-2xl font-bold text-ink-heading">@(Model.TaskItem.Title ?? Localizer["Tasks.Index.UntitledFallback"])</h1>
                @if (!string.IsNullOrWhiteSpace(Model.TaskItem.Description))
                {
                    <p class="mt-3 text-ink-secondary whitespace-pre-line">@Model.TaskItem.Description</p>
                }
            </div>
            <div class="flex gap-2 shrink-0">
                @if (Model.CanClaim)
                {
                    <form method="post" asp-page-handler="Claim"><button type="submit" class="btn-action btn-action-secondary px-3 py-2"><i class="bi bi-person-check mr-1"></i>@Localizer["Tasks.Action.Claim"]</button></form>
                }
                @if (Model.CanRelease)
                {
                    <form method="post" asp-page-handler="Release"><button type="submit" class="btn-action btn-action-secondary px-3 py-2"><i class="bi bi-person-dash mr-1"></i>@Localizer["Tasks.Action.Release"]</button></form>
                }
            </div>
        </div>

        <dl class="mt-5 pt-4 border-t border-line grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div><dt class="text-ink-muted">@Localizer["Tasks.Detail.Created"]</dt><dd class="font-medium">@Model.TaskItem.CreatedAt.ToLocalTime().ToString("f")</dd></div>
            <div>
                <dt class="text-ink-muted">@Localizer["Tasks.Index.Due"]</dt>
                <dd class="font-medium @(overdue ? "text-red-700 dark:text-red-300" : "")">@(Model.TaskItem.DueDate?.ToLocalTime().ToString("f") ?? Localizer["Tasks.Detail.NoDueDate"])</dd>
            </div>
        </dl>
    </header>

    @if (Model.TaskItem.FormId.HasValue)
    {
        <main class="card p-5" aria-label="Task form" data-argent-public-form
              data-bootstrap-url="/api/runtime/tasks/@Model.Id/form/bootstrap"
              data-submit-url="/api/runtime/tasks/@Model.Id/form/submit"
              data-success-redirect="/Tasks"
              data-unavailable-message="@Localizer["Tasks.Detail.Unavailable"]"
              data-access-lost-message="@Localizer["Tasks.Detail.AccessLost"]"
              data-conflict-message="@Localizer["Tasks.Detail.Conflict"]">
            <div data-form-status role="status">Loading form…</div>
            <argent-form></argent-form>
        </main>
    }
    else
    {
        <section class="card p-5" aria-labelledby="task-actions-heading">
            <h2 id="task-actions-heading" class="text-lg font-semibold mb-3">@Localizer["Tasks.Detail.AvailableActions"]</h2>
            <form method="post" asp-page-handler="Complete" class="flex gap-2 flex-wrap" data-submit-once>
                @if (Model.Actions.Count > 0)
                {
                    @foreach (var action in Model.Actions)
                    {
                        <button class="btn-action btn-action-@action.Appearance px-4 py-2" type="submit" name="action"
                                value="@action.Key" data-confirm="@action.Confirm">@action.Label</button>
                    }
                }
                else
                {
                    <button class="btn-action btn-action-primary px-4 py-2" type="submit">@Localizer["Tasks.Detail.Complete"]</button>
                }
            </form>
        </section>
    }
</div>

@section Scripts {
    @if (Model.TaskItem.FormId.HasValue)
    {
        <script type="module" src="~/js/public-form.js" asp-append-version="true"></script>
    }
    else
    {
        <script type="module" src="~/js/task-actions.js" asp-append-version="true"></script>
    }
}
