@page "/Forms/Live/{id:guid}"
@model Argent.Web.Pages.Forms.LiveModel
@{
    ViewData["Title"] = Model.FormName;
}

<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">@Model.FormName</h1>
    <div class="card">
        <div class="p-5" data-argent-public-form data-form-id="@Model.Id">
            <div data-form-status role="status">Loading form…</div>
            <argent-form></argent-form>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/public-form.js" asp-append-version="true"></script>
}
