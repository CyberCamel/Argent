@page "/DomainObjects/{Key}/Records"
@using Microsoft.Extensions.Localization
@model Argent.Web.Pages.DomainObjects.Records.IndexModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = $"{Model.Definition.DisplayName} {Localizer["DomainObjects.Records.PageTitle"]}";
}

<div class="flex flex-wrap justify-between items-center gap-4 mb-6">
    <div>
        <nav class="flex items-center gap-1.5 text-sm text-ink-muted mb-1">
            <a href="/DomainObjects" class="hover:text-ink transition-colors">Domain Objects</a>
            <span class="text-ink-muted">/</span>
            <span class="text-ink-heading font-medium">@Model.Definition.DisplayName</span>
        </nav>
        <h1 class="text-xl font-bold text-ink-heading">@Model.Definition.DisplayName @Localizer["DomainObjects.Records.PageTitle"]</h1>
        <p class="text-sm text-ink-muted">@Model.TotalCount record@(Model.TotalCount == 1 ? "" : "s")</p>
    </div>
    <a class="btn btn-primary" href="/DomainObjects/@Model.Key/Records/Form">
        <i class="bi bi-plus-lg"></i> @Localizer["DomainObjects.Records.NewRecord"]
    </a>
</div>

@if (Model.Records.Count == 0)
{
    <div class="card text-center py-12">
        <i class="bi bi-inbox text-4xl text-ink-muted mb-3 block"></i>
        <p class="text-ink-muted text-sm mb-0">
            @Localizer["DomainObjects.Records.EmptyMessage"] <a href="/DomainObjects/@Model.Key/Records/Form" class="text-accent-text hover:underline">Create the first one</a>.
        </p>
    </div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    @foreach (var prop in Model.Definition.Properties.Take(5))
                    {
                        <th>@prop.DisplayName</th>
                    }
                    <th class="text-right">@Localizer["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        @foreach (var prop in Model.Definition.Properties.Take(5))
                        {
                            <td class="text-sm">
                                @{
                                    record.Values.TryGetValue(prop.Key, out var val);
                                    var display = val?.ToString();
                                    if (display != null && display.Length > 60)
                                        display = display[..57] + "…";
                                }
                                @(display ?? "—")
                            </td>
                        }
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a class="btn-action btn-action-secondary"
                                   href="/DomainObjects/@Model.Key/Records/Form?id=@record.Id" title="@Localizer["Common.Edit"]">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@record.Id"
                                      asp-route-key="@Model.Key" style="display:inline"
                                      onsubmit="return confirm('@Localizer["DomainObjects.Records.DeleteConfirm"]')">
                                    <button class="btn-action btn-action-danger" title="@Localizer["Common.Delete"]">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
