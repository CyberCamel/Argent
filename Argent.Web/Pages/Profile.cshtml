@page
@model Argent.Web.Pages.ProfileModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Profile.PageTitle"];
}

<div class="flex justify-center">
    <div class="w-full max-w-md">
        <div class="card">
            <div class="p-6 text-center">
                <span class="avatar avatar-lg mx-auto mb-3">@(Model._user?.FirstName?[0])</span>
                <h2 class="text-lg font-bold text-ink-heading mb-1">@Model._user?.FirstName @Model._user?.LastName</h2>
                <p class="text-sm text-ink-muted mb-3">@@@Model._user?.UserName</p>

                @if (Model.UserRoles.Count > 0)
                {
                    <div class="flex justify-center gap-2 flex-wrap">
                        @foreach (var role in Model.UserRoles)
                        {
                            <span class="badge badge-accent">@role</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
