@page "/Workflows"
@using Microsoft.Extensions.Localization
@model Argent.Web.Pages.Workflows.IndexModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Workflows.Index.PageTitle"];
}

<partial name="~/Pages/Shared/_PageHeader.cshtml" model='new Argent.Web.Pages.Shared.PageHeaderModel {
    Title = Localizer["Workflows.Index.PageTitle"].Value,
    Subtitle = Localizer["Workflows.Index.Subtitle"].Value,
    ActionModal = new Argent.Web.Pages.Shared.ModalModel(Localizer["Workflows.Index.NewWorkflow"].Value, "createModal", "bi-plus-lg")
}' />

@if (Model.Defs.Count == 0)
{
    <partial name="~/Pages/Shared/_EmptyState.cshtml" model='new Argent.Web.Pages.Shared.EmptyStateModel {
        Icon = "bi-diagram-3",
        Message = Localizer["Workflows.Index.EmptyMessage"].Value
    }' />
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@Localizer["Common.Name"]</th>
                    <th>@Localizer["Common.Description"]</th>
                    <th class="text-right">@Localizer["Common.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var wf in Model.Defs)
                {
                    <tr>
                        <td class="table-primary">@wf.Name</td>
                        <td class="table-meta">@wf.Description</td>
                        <td class="text-right">
                            <div class="table-actions">
                                @if (Model.DeployedWorkflowIds.Contains(wf.Id))
                                {
                                    <a class="btn-action btn-action-success" href="/Workflows/Start?workflowId=@wf.Id" title="@Localizer["Workflows.Index.StartTooltip"]" aria-label="@Localizer["Workflows.Index.StartTooltip"]">
                                        <i class="bi bi-play-fill" aria-hidden="true"></i>
                                    </a>
                                }
                                <a class="btn-action btn-action-primary" href="/Workflows/View/@wf.Id" title="@Localizer["Common.View"]" aria-label="@Localizer["Common.View"]">
                                    <i class="bi bi-eye-fill" aria-hidden="true"></i>
                                </a>
                                <a class="btn-action btn-action-secondary" href="/Workflows/Edit/@wf.Id" title="@Localizer["Common.Edit"]" aria-label="@Localizer["Common.Edit"]">
                                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@wf.Id" style="display:inline"
                                      onsubmit="return confirm('@Localizer["Workflows.Index.DeleteConfirm"]')">
                                    <button class="btn-action btn-action-danger" title="@Localizer["Common.Delete"]" aria-label="@Localizer["Common.Delete"]">
                                        <i class="bi bi-trash-fill" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Create modal *@
<div id="createModal" class="dialog-backdrop"
     x-data="{ open: false }"
     x-init="open = false"
     x-show="open"
     x-cloak
     @@open-modal.window="if ($event.detail === 'createModal') open = true"
     @@keydown.escape.window="open = false">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="createModalTitle" @@click.outside="open = false">
        <div class="dialog-header">
            <h2 class="dialog-title" id="createModalTitle">@Localizer["Workflows.Index.ModalTitle"]</h2>
            <button type="button" class="dialog-close" @@click="open = false" aria-label="@Localizer["Common.Close"]">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <form method="post" asp-page-handler="Create" class="flex flex-col min-h-0">
            <div class="dialog-body flex flex-col gap-4">
                <div class="field">
                    <label for="name" class="form-label">@Localizer["Common.Name"]</label>
                    <input id="name" name="name" type="text" required placeholder="@Localizer["Workflows.Index.ModalNamePlaceholder"]" class="form-input" />
                </div>
                <div class="field">
                    <label for="description" class="form-label">@Localizer["Common.Description"]</label>
                    <textarea id="description" name="description" class="form-textarea" rows="3" placeholder="@Localizer["Workflows.Index.ModalDescriptionPlaceholder"]"></textarea>
                </div>
            </div>
            <div class="dialog-footer">
                <button type="button" class="btn btn-secondary" @@click="open = false">@Localizer["Common.Cancel"]</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save-fill" aria-hidden="true"></i> @Localizer["Workflows.Index.ModalCreate"]
                </button>
            </div>
        </form>
    </div>
</div>
