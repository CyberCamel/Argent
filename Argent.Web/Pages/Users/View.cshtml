@page "/Users/View/{id:guid}"
@model Argent.Web.Pages.Users.ViewModel
@{
    ViewData["Title"] = Localizer["Users.View.PageTitle"];
}

<div class="max-w-2xl mx-auto">
    <a href="javascript:history.back()" class="btn-action btn-action-secondary text-sm inline-flex items-center gap-1 px-3 py-1.5 rounded-lg mb-3">
        <i class="bi bi-arrow-left"></i> @Localizer["Common.Back"]
    </a>

    <div class="card">
        <div class="p-6">
            <div class="flex items-center gap-4 mb-6">
                <div class="bg-indigo-600 text-white rounded-full flex items-center justify-center flex-shrink-0"
                     style="width: 56px; height: 56px; font-size: 1.25rem; font-weight: 600;">
                    @Model.Detail.FirstName[0]@Model.Detail.LastName[0]
                </div>
                <div>
                    <h2 class="text-lg font-bold text-ink-heading mb-0">@Model.Detail.FirstName @Model.Detail.LastName</h2>
                    <span class="text-sm text-ink-muted">@@@Model.Detail.UserName</span>
                </div>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                @if (!string.IsNullOrEmpty(Model.Detail.Email))
                {
                    <div>
                        <dt class="text-xs font-medium text-ink-muted uppercase tracking-wider">@Localizer["Users.View.EmailLabel"]</dt>
                        <dd class="text-ink-heading mt-0.5">@Model.Detail.Email</dd>
                    </div>
                }
                <div>
                    <dt class="text-xs font-medium text-ink-muted uppercase tracking-wider">@Localizer["Users.View.DepartmentLabel"]</dt>
                    <dd class="text-ink-heading mt-0.5">@(Model.Detail.Department ?? "—")</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-ink-muted uppercase tracking-wider">@Localizer["Users.View.ManagerLabel"]</dt>
                    <dd class="text-ink-heading mt-0.5">@(Model.Detail.IsManager ? "Yes" : "No")</dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs font-medium text-ink-muted uppercase tracking-wider">@Localizer["Users.View.RolesLabel"]</dt>
                    <dd class="mt-0.5">
                        @if (Model.Detail.Roles.Count == 0)
                        {
                            <span class="text-gray-400 text-sm">@Localizer["Users.View.NoRoles"]</span>
                        }
                        else
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var role in Model.Detail.Roles)
                                {
                                    <span class="badge badge-neutral">@role</span>
                                }
                            </div>
                        }
                    </dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-xs font-medium text-ink-muted uppercase tracking-wider">@Localizer["Users.View.GroupsLabel"]</dt>
                    <dd class="mt-0.5">
                        @if (Model.Detail.Groups.Count == 0)
                        {
                            <span class="text-gray-400 text-sm">@Localizer["Users.View.NoGroups"]</span>
                        }
                        else
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var group in Model.Detail.Groups)
                                {
                                    <span class="badge badge-info">@group</span>
                                }
                            </div>
                        }
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</div>
