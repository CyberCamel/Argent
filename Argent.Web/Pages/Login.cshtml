@page
@model Argent.Web.Pages.LoginModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

<div class="flex justify-center py-8">
    <div class="w-full" style="max-width:24rem">
        <div class="mb-6 text-center">
            <h1 class="page-header-title" style="font-size:var(--font-size-lg)">@Localizer["Login.Heading"]</h1>
            <p class="page-header-subtitle mt-1" style="font-size:var(--font-size-sm)">@Localizer["Login.Subtitle"]</p>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="post">
                    @* The validation-summary tag helper always emits its element, even with
                       nothing to report. Guard it, or the empty .alert renders as a stray
                       coloured box above the form. *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger mb-4"></div>
                    }

                    <fieldset class="form-fieldset">
                        <legend class="sr-only">@Localizer["Login.Heading"]</legend>
                        <div class="flex flex-col gap-4">
                            <div class="field">
                                <label asp-for="Input.UserName" class="form-label">@Localizer["Login.UsernameLabel"]</label>
                                <input asp-for="Input.UserName" class="form-input" placeholder="@Localizer["Login.UsernamePlaceholder"]" autocomplete="username" />
                            </div>
                            <div class="field">
                                <label asp-for="Input.Password" class="form-label">@Localizer["Login.PasswordLabel"]</label>
                                <input asp-for="Input.Password" class="form-input" placeholder="@Localizer["Login.PasswordPlaceholder"]" autocomplete="current-password" />
                            </div>
                            <label class="form-check" for="rememberMeCheck">
                                <input asp-for="Input.RememberMe" id="rememberMeCheck" />
                                <span>@Localizer["Login.RememberMe"]</span>
                            </label>
                        </div>
                    </fieldset>

                    <button type="submit" class="btn btn-primary btn-lg w-full mt-6">@Localizer["Login.LogInButton"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
